---
import { ViewTransitions } from 'astro:transitions';
import AdSlot from '../components/AdSlot.astro';
import navData from '../data/navigation.json';
import themeRaw from '../theme-settings.json';

const theme = themeRaw || {};
const { navItems } = navData;

export interface Props {
  image?: string;
  canonicalURL?: string | URL;
  // Extended SEO props from blog/tutorial frontmatter
  seoTitle?: string;      // Custom browser-tab/Google title (overrides title)
  ogImage?: string;       // Custom OG image (overrides image)
  noindex?: boolean;      // Add noindex meta tag
  keywords?: string;      // SEO Keywords
  ogType?: string;        // Custom OG Type (e.g. article)
  schemaData?: object[];  // Array of Schema.org JSON-LD objects
}

const {
  title,
  description,
  image = '/og-image.png',
  canonicalURL,
  seoTitle,
  ogImage,
  ogType: propOgType,
  noindex = false,
  keywords,
  schemaData = [],
} = Astro.props;

// Canonical URL Normalization Function: Ensures a single, consistent trailing-slash format
const siteOrigin = Astro.site ? Astro.site.origin : 'https://codescompiler.com';

function getCanonicalUrl(rawUrl?: string | URL): string {
  const url = rawUrl
    ? new URL(rawUrl.toString(), siteOrigin)
    : new URL(Astro.url.pathname, siteOrigin);

  let path = url.pathname.replace(/\\+/g, '/');
  if (!path.endsWith('/') && !path.includes('.')) {
    path += '/';
  }

  return new URL(path, siteOrigin).href;
}

const canonicalUrl = getCanonicalUrl(canonicalURL);

// The title that goes in <title> tag and OG title
const pageTitle = seoTitle || title;
const displayTitle = pageTitle.includes('CodesCompiler') ? pageTitle : `${pageTitle} — CodesCompiler`;
// The image used for OG/Twitter cards
const socialImage = ogImage || image;

// og:type is article if passed or for blog posts; otherwise website
const ogType = propOgType || (Astro.url.pathname.startsWith('/blog/') ? 'article' : 'website');

// All tutorials for the search index (flat list for auto-suggest)
const tutorialLinks = [
  { label: 'HTML Tutorial', href: '/tutorial/html-introduction/', cat: 'HTML' },
  { label: 'CSS Tutorial', href: '/tutorial/css-introduction/', cat: 'CSS' },
  { label: 'JavaScript Tutorial', href: '/tutorial/javascript-introduction/', cat: 'JavaScript' },
  { label: 'SEO Tutorial', href: '/tutorial/seo-introduction/', cat: 'SEO' },
  { label: 'Python Tutorial', href: '/tutorial/python-introduction/', cat: 'Python' },
  { label: 'SQL Tutorial', href: '/tutorial/sql-introduction/', cat: 'SQL' },
  { label: 'PHP Tutorial', href: '/tutorial/php-introduction/', cat: 'PHP' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E4RQHDFMTX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-E4RQHDFMTX');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{displayTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(socialImage, siteOrigin)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(socialImage, siteOrigin)} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">

    {schemaData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {Astro.url.pathname.includes('/tutorial/python-') && (
      <>
        <link rel="stylesheet" href="https://pyscript.net/latest/pyscript.css" />
        <script defer src="https://pyscript.net/latest/pyscript.js"></script>
      </>
    )}
  <!-- ADMIN-INJECTED-START -->
    <meta http-equiv="Cache-Control" content="public, max-age=3600" />
    <!-- ADMIN-INJECTED-END -->
    <!-- Dark Mode Init -->
    <script is:inline>
      if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark-theme');
      } else {
        document.documentElement.classList.remove('dark-theme');
      }
    </script>
    
    {theme.customHeadCode && <Fragment set:html={theme.customHeadCode} />}
    <link rel="stylesheet" href="/custom.css" />
</head>
  <body class={`min-h-screen flex flex-col bg-white text-gray-900 antialiased ${theme.bodyClass || ''}`} style="font-family: 'Source Sans 3', sans-serif;">

    <!-- ============================================================ -->
    <!-- NEW HEADER & NAVBAR                                          -->
    <!-- ============================================================ -->
