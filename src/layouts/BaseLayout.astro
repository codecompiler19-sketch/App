---
import { ViewTransitions } from 'astro:transitions';
import AdSlot from '../components/AdSlot.astro';
import navData from '../data/navigation.json';
import themeRaw from '../theme-settings.json';

const theme = themeRaw || {};
const { navItems } = navData;

export interface Props {
  image?: string;
  canonicalURL?: string | URL;
  // Extended SEO props from blog/tutorial frontmatter
  seoTitle?: string;      // Custom browser-tab/Google title (overrides title)
  ogImage?: string;       // Custom OG image (overrides image)
  noindex?: boolean;      // Add noindex meta tag
  keywords?: string;      // SEO Keywords
  ogType?: string;        // Custom OG Type (e.g. article)
  schemaData?: object[];  // Array of Schema.org JSON-LD objects
}

const {
  title,
  description,
  image = '/og-image.png',
  canonicalURL,
  seoTitle,
  ogImage,
  ogType: propOgType,
  noindex = false,
  keywords,
  schemaData = [],
} = Astro.props;

// Canonical URL Normalization Function: Ensures a single, consistent trailing-slash format
const siteOrigin = Astro.site ? Astro.site.origin : 'https://codescompiler.com';

function getCanonicalUrl(rawUrl?: string | URL): string {
  const url = rawUrl
    ? new URL(rawUrl.toString(), siteOrigin)
    : new URL(Astro.url.pathname, siteOrigin);

  let path = url.pathname.replace(/\\+/g, '/');
  if (!path.endsWith('/') && !path.includes('.')) {
    path += '/';
  }

  return new URL(path, siteOrigin).href;
}

const canonicalUrl = getCanonicalUrl(canonicalURL);

// The title that goes in <title> tag and OG title
const pageTitle = seoTitle || title;
const displayTitle = pageTitle.includes('CodesCompiler') ? pageTitle : `${pageTitle} — CodesCompiler`;
// The image used for OG/Twitter cards
const socialImage = ogImage || image;

// og:type is article if passed or for blog posts; otherwise website
const ogType = propOgType || (Astro.url.pathname.startsWith('/blog/') ? 'article' : 'website');

// All tutorials for the search index (flat list for auto-suggest)
const tutorialLinks = [
  { label: 'HTML Tutorial', href: '/tutorial/html-introduction/', cat: 'HTML' },
  { label: 'CSS Tutorial', href: '/tutorial/css-introduction/', cat: 'CSS' },
  { label: 'JavaScript Tutorial', href: '/tutorial/javascript-introduction/', cat: 'JavaScript' },
  { label: 'SEO Tutorial', href: '/tutorial/seo-introduction/', cat: 'SEO' },
  { label: 'Python Tutorial', href: '/tutorial/python-introduction/', cat: 'Python' },
  { label: 'SQL Tutorial', href: '/tutorial/sql-introduction/', cat: 'SQL' },
  { label: 'PHP Tutorial', href: '/tutorial/php-introduction/', cat: 'PHP' },
];
---

