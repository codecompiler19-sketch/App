            </nav>
            <div class="hidden lg:flex items-center gap-1 whitespace-nowrap">
              <button id="theme-toggle" class="cc-top-link" aria-label="Toggle Dark Mode" onclick="toggleDarkMode()"><span class="cc-sun">☀</span> Light</button>
              <button class="cc-top-link" type="button" onclick="document.getElementById('main-search')?.focus()" aria-label="Focus search"><span class="cc-search-symbol">⌕</span> Search</button>
              <a href="/about/" class="cc-top-link"><span class="cc-top-icon"><svg class="cc-nav-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18V3Z"/><path d="M12 3a9 9 0 0 1 0 18"/></svg></span> About</a>
            </div>
          </div>
        </div>
      </div>

      <div id="cc-brand-row" class="w-full bg-white">
        <div class="max-w-screen-2xl mx-auto px-4 lg:px-8 py-4">
