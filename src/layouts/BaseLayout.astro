    <!-- Hide the utility top bar while scrolling down; reveal it when scrolling up. -->
    <script is:inline>
      (() => {
        let lastScrollY = window.scrollY;
        let ticking = false;

        const updateHeader = () => {
          const header = document.getElementById('site-header');
          const currentY = window.scrollY;

          if (header) {
            // Mobile uses the dedicated reading-mode behavior above.
            if (window.innerWidth <= 767) {
              header.classList.remove('cc-header-hidden');
              lastScrollY = Math.max(currentY, 0);
              ticking = false;
              return;
            }

            if (currentY <= 8 || currentY < lastScrollY) {
              header.classList.remove('cc-header-hidden');
            } else if (currentY > lastScrollY + 6) {
              header.classList.add('cc-header-hidden');
            }
          }

          lastScrollY = Math.max(currentY, 0);
          ticking = false;
        };

        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(updateHeader);
            ticking = true;
          }
        }, { passive: true });

        document.addEventListener('astro:after-swap', () => {
          lastScrollY = window.scrollY;
          document.getElementById('site-header')?.classList.remove('cc-header-hidden');
        });
      })();
    </script>

    <!-- Client-side script to handle social sidebar toggle and persistence -->
    <script is:inline>
      function initSocialSidebar() {
        const sidebar = document.getElementById('social-sidebar');
        if (!sidebar) return;

        const storedState = sessionStorage.getItem('social-sidebar-state');

        if (storedState) {
          if (storedState === 'collapsed') {
            sidebar.classList.add('collapsed');
          } else {
            sidebar.classList.remove('collapsed');
          }
        } else {
          // Collapse by default on all devices so the auto-open effect works
          sidebar.classList.add('collapsed');
        }
      }

      // Initial execution
      initSocialSidebar();

      // Auto-open after 5 seconds, then close after 3 seconds (on initial page load)
      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
          const sidebar = document.getElementById('social-sidebar');
          if (sidebar && sidebar.classList.contains('collapsed')) {
            sidebar.classList.remove('collapsed');
            
            // Close it again after 3 seconds
            setTimeout(() => {
              if (sidebar && !sidebar.classList.contains('collapsed')) {
                sidebar.classList.add('collapsed');
                sessionStorage.setItem('social-sidebar-state', 'collapsed');
              }
            }, 3000);
          }
        }, 5000);
      });

      // Listeners for standard load, back/forward cache, and astro route changes
      document.addEventListener('astro:after-swap', initSocialSidebar);

      // Delegate click listener to avoid duplicate bindings during route transitions
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('#social-sidebar-toggle');
        if (btn) {
          const sidebar = document.getElementById('social-sidebar');
          if (sidebar) {
            sidebar.classList.toggle('collapsed');
            const newState = sidebar.classList.contains('collapsed') ? 'collapsed' : 'expanded';
            sessionStorage.setItem('social-sidebar-state', newState);
          }
        }
      });
    </script>
