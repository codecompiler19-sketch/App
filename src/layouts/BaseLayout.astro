              </div>
            </div>
            <button id="mobile-theme-toggle" class="md:hidden flex-shrink-0 p-2 rounded-full hover:bg-slate-100 text-slate-700" aria-label="Toggle Dark Mode" onclick="toggleDarkMode()"><span class="text-xl">☾</span></button>
          </div>
        </div>
      </div>

      <div class="cc-lang-strip w-full border-y border-slate-200 bg-white">
        <div class="max-w-screen-2xl mx-auto flex items-stretch">
          <div class="cc-tutorial-mobile-control md:hidden flex-shrink-0">
            <slot name="tutorial-nav-control" />
          </div>
          <div class={Astro.url.pathname.startsWith("/tutorial/") ? "hidden md:block flex-1 min-w-0 overflow-x-auto scrollbar-hide" : "flex-1 min-w-0 overflow-x-auto scrollbar-hide"}>
            <nav class="flex min-w-max items-stretch" aria-label="Programming languages">
            <a href="/tutorial/html-introduction/" class="cc-lang-link"><span class="cc-lang-icon cc-html" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 3h14l-1.5 17L12 22 6.5 20 5 3Z"/><path d="M8 7h8l-.25 3H8.3l.25 3h7.05l-.25 3-3.35 1-3.35-1"/></svg></span><span>HTML</span></a>
            <a href="/tutorial/css-introduction/" class="cc-lang-link"><span class="cc-lang-icon cc-css" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 3h14l-1.5 17L12 22 6.5 20 5 3Z"/><path d="M8 7h8M8.5 11h7M9 15h6"/></svg></span><span>CSS</span></a>
            <a href="/tutorial/javascript-introduction/" class="cc-lang-link"><span class="cc-lang-icon cc-js">JS</span><span>JavaScript</span></a>
            <a href="/tutorial/python-introduction/" class="cc-lang-link"><span class="cc-lang-icon cc-python">Py</span><span>Python</span></a>
            <a href="/tutorial/sql-introduction/" class="cc-lang-link"><span class="cc-lang-icon cc-sql">DB</span><span>SQL</span></a>
            <a href="/tutorial/php-introduction/" class="cc-lang-link"><span class="cc-lang-icon cc-php">php</span><span>PHP</span></a>
            <a href="/tutorial/seo-introduction/" class="cc-lang-link"><span class="cc-lang-icon cc-seo">↗</span><span>SEO</span></a>
          </nav>
          </div>
          {Astro.url.pathname.startsWith('/tutorial/') && (
            <nav class="md:hidden flex-1 min-w-0 flex items-center justify-end gap-2 px-3 text-sm text-slate-500" aria-label="Breadcrumb">
              <a href="/" class="flex-shrink-0 hover:text-[#04AA6D]">Home</a>
              <span aria-hidden="true">/</span>
              <a href={`/tutorial/${(Astro.url.pathname.split('/')[2] || 'html').replace(/-introduction$/, '')}-introduction/`} class="flex-shrink-0 capitalize hover:text-[#04AA6D]">{(Astro.url.pathname.split('/')[2] || 'Tutorial').replace(/-introduction$/, '')}</a>
              <span aria-hidden="true">/</span>
              <span class="min-w-0 truncate font-semibold text-slate-800" title={title}>{title}</span>
            </nav>
          )}
        </div>
      </div>

      <div class="md:hidden px-4 py-3 bg-white border-b border-slate-200 relative" id="mobile-search-wrapper">
        <div class="cc-main-search">
          <input type="search" id="mobile-search" placeholder="Search tutorials..." autocomplete="off" aria-label="Search tutorials">
          <span class="cc-main-search-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
          </span>
          <div id="mobile-search-dropdown" class="hidden absolute left-4 right-4 top-full mt-1"></div>
        </div>
      </div>

      <div class="mobile-drawer" id="drawer">
        {navItems.map((item: any) => {
          if (item.type === 'mega' || item.type === 'dropdown') {
            return (
              <div class="m-item">
                <div class="m-header" onclick="toggleSection(this)">{item.label} <span class="m-arr">▼</span></div>
                <div class="m-body">
                  {item.sections.map((sec: any) => (
                    <>
                      {sec.title && <div style="padding:6px 18px 2px;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#aaa;font-weight:700;">{sec.title}</div>}
                      {sec.links.map((link: any) => (
                        <a href={link.href}>{link.label}{link.badge && <span class="mbadge soon">{link.badge}</span>}</a>
                      ))}
                    </>
                  ))}
                </div>
              </div>
            );
          } else if (item.type === 'link') {
            return <a href={item.href} class="m-single">{item.label}</a>;
          }
        })}
        <a href="/about/" class="m-single">About</a>
        <a href="/contact/" class="m-single">Contact</a>
        <a href="/tutorial/html-introduction/" class="m-getstarted">🚀 Get Started Free</a>
      </div>
    </header>

    <!-- Mobile reading mode: collapse everything except the brand row while scrolling down. -->
    <script is:inline>
      (() => {
        const header = document.getElementById('site-header');
        if (!header) return;

        let lastScrollY = window.scrollY;
        let ticking = false;

        const updateMobileHeader = () => {
          ticking = false;
          if (window.innerWidth > 767) {
            header.classList.remove('cc-header-compact');
            lastScrollY = window.scrollY;
            return;
          }

          const currentY = window.scrollY;
          const scrollingDown = currentY > lastScrollY;
          const scrollingUp = currentY < lastScrollY;

          const langStrip = header.querySelector('.cc-lang-strip');

          if (currentY <= 24) {
            header.classList.remove('cc-header-compact');
            langStrip?.classList.remove('cc-lang-hidden');
          } else if (scrollingDown && currentY > 56) {
            header.classList.add('cc-header-compact');
            langStrip?.classList.add('cc-lang-hidden');
          } else if (scrollingUp) {
            // Keep the compact brand row while reading, but bring back the
            // tutorial/category row so the user can quickly switch topics.
            header.classList.add('cc-header-compact');
            langStrip?.classList.remove('cc-lang-hidden');
          }

          lastScrollY = currentY;
        };

        const onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(updateMobileHeader);
            ticking = true;
          }
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', updateMobileHeader, { passive: true });
        updateMobileHeader();
      })();
    </script>

    <style is:global>
      /* Mobile reading mode: keep only hamburger + logo + theme control visible while reading. */
      @media (max-width: 767px) {
        .cc-site-header.cc-header-compact #cc-topbar,
        .cc-site-header.cc-header-compact #mobile-search-wrapper {
          display: none !important;
        }

        .cc-site-header .cc-lang-strip {
          max-height: 68px;
          overflow: hidden;
          transition: max-height .22s ease, opacity .18s ease, transform .22s ease;
        }

        .cc-site-header .cc-lang-strip.cc-lang-hidden {
          max-height: 0 !important;
          opacity: 0;
          border-top-width: 0;
          border-bottom-width: 0;
          transform: translateY(-4px);
          pointer-events: none;
        }

        .cc-tutorial-mobile-control {
          display: flex;
          align-items: stretch;
          background: #fff;
          border-right: 1px solid #e2e8f0;
        }

        .cc-mobile-sidebar-toggle {
          width: 145px;
          min-width: 145px;
          height: 48px;
          margin: 6px;
          padding: 0 10px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          border: 0;
          border-radius: 13px;
          background: #f1f5fb;
          color: #172033;
          cursor: pointer;
          font-size: 14px;
          font-weight: 700;
          line-height: 1;
          white-space: nowrap;
          box-shadow: none;
          -webkit-tap-highlight-color: transparent;
        }

        .cc-mobile-sidebar-toggle svg {
          width: 22px;
          height: 22px;
          flex: 0 0 22px;
          fill: none;
          stroke: #04a875;
          stroke-width: 2.2;
          stroke-linecap: round;
        }

        .cc-mobile-sidebar-toggle:active {
          background: #e8eef7;
        }

        html.dark-theme .cc-tutorial-mobile-control {
          background: #0f172a;
          border-color: #334155;
        }

        html.dark-theme .cc-mobile-sidebar-toggle {
          background: #1e293b;
          color: #f1f5f9;
        }

        html.dark-theme .cc-mobile-sidebar-toggle:active {
          background: #334155;
        }

        .cc-site-header.cc-header-compact #cc-brand-row {
          box-shadow: 0 2px 12px rgba(15, 23, 42, 0.10);
        }

        .cc-site-header.cc-header-compact #cc-brand-row > div {
          padding-top: 7px !important;
          padding-bottom: 7px !important;
        }

        .cc-site-header.cc-header-compact #cc-brand-row img {
          width: 150px !important;
          max-height: 38px;
        }

        .cc-site-header.cc-header-compact .hamburger {
          padding-top: 6px;
          padding-bottom: 6px;
        }

        .cc-site-header.cc-header-compact #cc-brand-row {
          position: relative;
          z-index: 60;
        }

        .cc-site-header.cc-header-compact .cc-mobile-sidebar-toggle {
          height: 46px;
        }
      }

      .cc-site-header{--cc-topbar-height:48px;transform:translateY(0);transition:transform .28s ease;will-change:transform}.cc-site-header.cc-header-hidden{transform:translateY(calc(-1 * var(--cc-topbar-height)))}.cc-topbar{min-height:48px;transition:opacity .2s ease;will-change:opacity}.cc-topbar.cc-topbar-hidden{opacity:0}.cc-top-link{display:inline-flex;align-items:center;gap:.45rem;padding:.55rem .7rem;color:#0f172a;font-size:.95rem;font-weight:600;text-decoration:none;border-bottom:2px solid transparent;transition:all .18s ease}
      .cc-top-link:hover{color:#0f172a;background:#f8fafc}
      .cc-top-link.cc-active{border-bottom-color:#fbbf24}
      .cc-top-icon{display:inline-flex;align-items:center;justify-content:center;min-width:1.25rem;height:1.35rem;color:#10243d}.cc-nav-svg{width:1.25rem;height:1.25rem;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.cc-top-link.cc-active .cc-nav-svg{color:#9a7200}
      .cc-sun{color:#fbbf24;font-size:1.2rem;line-height:1}.cc-search-symbol{font-size:1.35rem;line-height:.8;font-weight:700}
      .cc-main-search{position:relative;width:100%;display:flex;align-items:center;min-height:52px;border:1px solid #d8dde6;border-radius:9999px;background:#fff;box-shadow:0 1px 2px rgba(15,23,42,.03);transition:border-color .18s ease,box-shadow .18s ease}
      .cc-main-search:focus-within{border-color:#f5b900;box-shadow:0 0 0 3px rgba(251,191,36,.15)}
      .cc-main-search-icon{order:2;flex:0 0 24px;width:24px;height:24px;margin-right:1.05rem;color:#10243d;display:inline-flex;align-items:center;justify-content:center}
      .cc-main-search-icon svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
      .cc-main-search input{order:1;flex:1;min-width:0;width:100%;border:0;outline:0;background:transparent;color:#0f172a;font-size:1.08rem;font-weight:500;line-height:1.4;padding:.85rem .55rem .85rem 1.15rem}
      .cc-main-search input::placeholder{color:#94a3b8;font-weight:400}
      #search-wrapper{z-index:70}
      #search-dropdown,.cc-search-dropdown{width:100%;background:#fff;border:1px solid #d7dee8;border-top:3px solid #f5b900;border-radius:0 0 16px 16px;box-shadow:0 16px 35px rgba(15,23,42,.16);overflow:hidden;max-height:420px;overflow-y:auto}
      .cc-search-result{display:flex;align-items:center;gap:14px;min-height:68px;padding:11px 18px;text-decoration:none;border-bottom:1px solid #e8edf3;background:#fff;transition:background .16s ease,transform .16s ease}
      .cc-search-result:last-child{border-bottom:0}
      .cc-search-result:hover{background:#fff9e8}
      .cc-search-result-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex:0 0 40px;background:#10243d;color:#fff;font-size:13px;font-weight:800;letter-spacing:-.2px;box-shadow:0 3px 8px rgba(15,36,61,.12)}
