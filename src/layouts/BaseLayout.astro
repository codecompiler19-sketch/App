    <!-- SEARCH AUTOCOMPLETE JS                                        -->
    <!-- ============================================================ -->
    <script is:inline define:vars={{ tutorialLinks }}>
      const searchInput = document.getElementById('main-search');
      const dropdown = document.getElementById('search-dropdown');
      const mobileSearchInput = document.getElementById('mobile-search');
      const mobileDropdown = document.getElementById('mobile-search-dropdown');

      const allItems = tutorialLinks;

      function renderDropdown(query, ddEl) {
        if (!ddEl) return;
        if (!query || query.trim().length < 1) {
          ddEl.classList.add('hidden');
          ddEl.innerHTML = '';
          return;
        }

        const q = query.trim().toLowerCase();
        const matches = allItems.filter(
          item => item.label.toLowerCase().includes(q) || item.cat.toLowerCase().includes(q)
        );

        if (matches.length === 0) {
          ddEl.innerHTML = `
            <div class="cc-search-result-empty">
              No tutorial found for <strong>"${query.trim()}"</strong>
            </div>
          `;
          ddEl.classList.remove('hidden');
          return;
        }

        ddEl.innerHTML = matches.map(item => {
          const iconClass = item.cat.toLowerCase().replace(/[^a-z]/g, '');
          const shortIcon = item.cat === 'JavaScript' ? 'JS' : item.cat === 'Python' ? 'Py' : item.cat;
          return `
            <a href="${item.href}" class="cc-search-result">
              <span class="cc-search-result-icon ${iconClass}">${shortIcon}</span>
              <span class="cc-search-result-copy">
                <span class="cc-search-result-title">${item.label}</span>
                <span class="cc-search-result-meta">${item.cat} Tutorial &nbsp;•&nbsp; Step-by-step learning</span>
              </span>
            </a>
          `;
        }).join('');

        ddEl.classList.remove('hidden');
      }

      searchInput?.addEventListener('input', (e) => renderDropdown(e.target.value, dropdown));
      searchInput?.addEventListener('focus', (e) => renderDropdown(e.target.value, dropdown));

      mobileSearchInput?.addEventListener('input', (e) => renderDropdown(e.target.value, mobileDropdown));
      mobileSearchInput?.addEventListener('focus', (e) => renderDropdown(e.target.value, mobileDropdown));

      document.addEventListener('click', (e) => {
        if (!document.getElementById('search-wrapper')?.contains(e.target)) {
          dropdown?.classList.add('hidden');
        }
        if (!document.getElementById('mobile-search-wrapper')?.contains(e.target)) {
          mobileDropdown?.classList.add('hidden');
        }
      });

      // Mobile menu: delegated events survive Astro view transitions and avoid
      // inline-handler/global-scope failures on mobile browsers.
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const hamburger = target.closest('#ham');
        if (hamburger) {
          const drawer = document.getElementById('drawer');
          if (!drawer) return;
          const isOpen = !drawer.classList.contains('open');
          drawer.classList.toggle('open', isOpen);
          hamburger.classList.toggle('open', isOpen);
          hamburger.setAttribute('aria-expanded', String(isOpen));
          return;
        }

        const header = target.closest('.mobile-drawer .m-header');
        if (header) {
          const body = header.nextElementSibling;
          if (!body || !body.classList.contains('m-body')) return;
          const isOpen = !body.classList.contains('open');

          document.querySelectorAll('.mobile-drawer .m-body').forEach((item) => item.classList.remove('open'));
          document.querySelectorAll('.mobile-drawer .m-header').forEach((item) => {
            item.classList.remove('active');
            item.setAttribute('aria-expanded', 'false');
          });

          if (isOpen) {
            body.classList.add('open');
            header.classList.add('active');
            header.setAttribute('aria-expanded', 'true');
          }
        }
      });


      // ── Mega Menu: position panels below the full header ──
      function positionMegaPanels() {
        const navBar = document.getElementById('mega-nav-bar');
        if (!navBar) return;
        const rect = navBar.getBoundingClientRect();
        const top = rect.bottom;
        document.querySelectorAll('.mega-panel').forEach(function(panel) {
          panel.style.top = top + 'px';
        });
      }
      positionMegaPanels();
      window.addEventListener('scroll', positionMegaPanels);
      window.addEventListener('resize', positionMegaPanels);
    </script>

    

