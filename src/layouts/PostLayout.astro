---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  image?: string;
  date?: string;
  category?: string;
  tags?: string[];
  author?: string;
  slug?: string;
  hasDemo?: boolean;
  // SEO overrides from frontmatter
  seoTitle?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
  imageAlt?: string;
}

const {
  title, description, image, date, category,
  tags = [], author = 'CodesCompiler', slug = '', hasDemo = false,
  seoTitle, canonicalUrl, ogImage, noindex = false,
  headings = [], imageAlt = title,
} = Astro.props;

// Fetch all posts for sidebar panels — only published
const allPostsRaw = await getCollection('blog');
const allPosts = allPostsRaw.filter(
  p => !p.data.status || p.data.status === 'published'
);
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const recentPosts = sortedPosts.slice(0, 6);

const categoryCounts = allPosts.reduce((acc, post) => {
  const cat = post.data.category;
  if(cat) {
    acc[cat] = (acc[cat] || 0) + 1;
  }
  return acc;
}, {} as Record<string, number>);

// Related Posts (same category, not this post)
const relatedPosts = allPosts
  .filter(p => p.data.category === category && p.slug !== slug)
  .slice(0, 4);

// Format date
const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

// Category badge colors + slugs
const CATEGORY_MAP: Record<string, { color: string; bg: string; href: string }> = {
  'HTML & CSS':          { color: '#E34F26', bg: '#fff4f0', href: '/blog?cat=html-css' },
  'JavaScript':          { color: '#ca8a04', bg: '#fefce8', href: '/blog?cat=javascript' },
  'JavaScript Projects': { color: '#eab308', bg: '#fef9c3', href: '/blog?cat=javascript-projects' },
  'Login Form':          { color: '#3b82f6', bg: '#eff6ff', href: '/blog?cat=login-form' },
  'Card Design':         { color: '#8b5cf6', bg: '#f5f3ff', href: '/blog?cat=card-design' },
  'Navigation Bar':      { color: '#ec4899', bg: '#fdf2f8', href: '/blog?cat=navigation-bar' },
  'Blog':                { color: '#10b981', bg: '#fff8d6', href: '/blog?cat=blog' },
  'Website Designs':     { color: '#06b6d4', bg: '#ecfeff', href: '/blog?cat=website-designs' },
  'Templates html':      { color: '#0f766e', bg: '#f0fdfa', href: '/blog?cat=templates-html' },
  'Image Slider':        { color: '#f97316', bg: '#fff7ed', href: '/blog?cat=image-slider' },
  'API Projects':        { color: '#6366f1', bg: '#eef2ff', href: '/blog?cat=api-projects' },
  'Sidebar Menu':        { color: '#84cc16', bg: '#f7fee7', href: '/blog?cat=sidebar-menu' },
  'CSS Buttons':         { color: '#f43f5e', bg: '#fff1f2', href: '/blog?cat=css-buttons' },
  'JavaScript Games':    { color: '#a855f7', bg: '#faf5ff', href: '/blog?cat=javascript-games' },
  'Preloader or Loader': { color: '#0ea5e9', bg: '#f0f9ff', href: '/blog?cat=preloader-or-loader' },
  'Form Validation':     { color: '#14b8a6', bg: '#f0fdfa', href: '/blog?cat=form-validation' },
  'Accordion':           { color: '#e11d48', bg: '#ffe4e6', href: '/blog?cat=accordion' },
  'Bootstrap':           { color: '#7e22ce', bg: '#faf5ff', href: '/blog?cat=bootstrap' },
  'Tabs':                { color: '#0369a1', bg: '#e0f2fe', href: '/blog?cat=tabs' },
  'Calendar':            { color: '#b91c1c', bg: '#fef2f2', href: '/blog?cat=calendar' }
};
const catMeta = category ? (CATEGORY_MAP[category] ?? { color: '#6b7280', bg: '#f3f4f6', href: '/blog/' }) : null;

// All unique tags across posts
const allTags = [...new Set(allPosts.flatMap(p => p.data.tags ?? []))].sort();

// Table of Contents (H2 and H3 only)
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);

// ── SCHEMA.ORG JSON-LD ─────────────────────────────────────
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://codescompiler.com';
const fullUrl = canonicalUrl ? new URL(canonicalUrl, siteUrl).href : `${siteUrl}/blog/${slug}/`;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": image ? (image.startsWith('http') ? image : `${siteUrl}${image}`) : undefined,
  "author": author === 'CodesCompiler'
    ? {
        "@type": "Organization",
        "name": "CodesCompiler",
        "url": siteUrl + '/'
      }
    : {
        "@type": "Person",
        "name": author
      },
  "datePublished": date ? new Date(date).toISOString() : undefined,
  "publisher": {
    "@type": "Organization",
    "name": "CodesCompiler",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": fullUrl
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl + '/' },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog/` },
    { "@type": "ListItem", "position": 3, "name": title, "item": fullUrl }
  ]
};

const schemaData = [blogPostingSchema, breadcrumbSchema];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  seoTitle={seoTitle}
  ogImage={ogImage}
  noindex={noindex}
  canonicalURL={canonicalUrl ? new URL(canonicalUrl) : undefined}
  schemaData={schemaData}
>
  <!-- ======================================================== -->
  <!-- FULL-WIDTH BREADCRUMB BAR                                 -->
  <!-- ======================================================== -->
  <div class="post-breadcrumb-bar">
    <div class="post-container">
      <nav class="post-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">›</span>
        <a href="/blog/">Posts</a>
        <span class="sep">›</span>
        <span class="current" title={title}>{title}</span>
      </nav>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- THREE-COLUMN BODY: [LEFT SIDEBAR] [ARTICLE] [RIGHT AD]   -->
  <!-- ======================================================== -->
  <div class="post-container post-body">

    <!-- Mobile sidebar toggle button -->
    <button class="mobile-sidebar-btn" id="postSidebarToggle" aria-label="Open sidebar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      Filters &amp; Categories
    </button>

    <!-- ── LEFT SIDEBAR ─────────────────────────────────────── -->
    <aside class="post-sidebar" id="postSidebar">

      <!-- Categories -->
      <div class="sidebar-widget">
        <h3 class="widget-title">📂 Categories</h3>
        <ul class="category-list">
          <li>
            <a href="/blog/" class="cat-link cat-all">
              <span class="cat-icon">🌐</span>
              <span class="cat-name">All Posts</span>
              <span class="cat-count">{allPosts.length}</span>
            </a>
          </li>
          {Object.entries(CATEGORY_MAP).map(([name, meta]) => (
            <li>
              <a href={meta.href} class="cat-link" style={`--cat-color:${meta.color};--cat-bg:${meta.bg}`}>
                <span class="cat-dot" style={`background:${meta.color}`}></span>
                <span class="cat-name">{name}</span>
                <span class="cat-count">{categoryCounts[name] ?? 0}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Recent Posts -->
      <div class="sidebar-widget">
        <h3 class="widget-title">🕒 Recent Posts</h3>
        <ul class="recent-list">
          {recentPosts.map(post => (
            <li class="recent-item">
              <a href={`/blog/${post.data.permalink || post.slug}/`} class="recent-link">
                {post.data.image && (
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="recent-thumb"
                    loading="lazy"
                    width="56"
                    height="56"
                  />
                )}
                <div class="recent-info">
                  <span class="recent-title">{post.data.title}</span>
                  <span class="recent-date">
                    {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tags -->
      {allTags.length > 0 && (
        <div class="sidebar-widget">
          <h3 class="widget-title">🏷️ Tags</h3>
          <div class="tag-cloud">
            {allTags.map(tag => (
              <a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="tag-pill">#{tag}</a>
            ))}
          </div>
        </div>
      )}

      <!-- Follow / Share Widget -->
      <div class="sidebar-widget widget-share">
        <h3 class="widget-title">📢 Share This Post</h3>
        <div class="share-buttons">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(fullUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn share-twitter"
          >𝕏 Twitter</a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(fullUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn share-facebook"
          >Facebook</a>
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + fullUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn share-whatsapp"
          >WhatsApp</a>
        </div>
      </div>
    </aside>

    <!-- ── MAIN ARTICLE ──────────────────────────────────────── -->
    <main class="post-main" id="postMain">

      <!-- Featured Image -->
      {image && (
        <div class="post-featured-img-wrap">
          <img
            src={image}
            alt={imageAlt}
            class="post-featured-img"
            width="900"
            height="475"
          />
        </div>
      )}

      <!-- Demo + Download Action Bar (shown when hasDemo=true) -->
      {hasDemo && slug && (
        <div class="post-demo-bar">
          <div class="demo-bar-left">
            <span class="demo-bar-icon">🚀</span>
            <span class="demo-bar-text">See it in action</span>
          </div>
          <div class="demo-bar-actions">
            <a
              href={`/blog-demo/${slug}/`}
              target="_blank"
              rel="noopener noreferrer"
              class="demo-btn demo-btn-green"
              id="btn-live-demo"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Live Demo
            </a>
            <a
              href={`/demos/${slug}.html`}
              download={`${title}.html`}
              class="demo-btn demo-btn-outline"
              id="btn-download"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              Download
            </a>
          </div>
        </div>
      )}

      <!-- Post Header -->
      <header class="post-header">
        {catMeta && category && (
          <a
            href={catMeta.href}
            class="post-cat-badge"
            style={`color:${catMeta.color};background:${catMeta.bg};border-color:${catMeta.color}30`}
          >
            {category}
          </a>
        )}
        <h1 class="post-title">{seoTitle || title}</h1>
        <p class="post-description">{description}</p>

        <!-- Meta row -->
        <div class="post-meta">
          <span class="meta-author">
            <span class="meta-avatar">CC</span>
            {author}
          </span>
          {formattedDate && (
            <span class="meta-date">📅 {formattedDate}</span>
          )}
          {tags.length > 0 && (
            <div class="meta-tags">
              {tags.map(t => <span class="meta-tag">#{t}</span>)}
            </div>
          )}
        </div>
      </header>

      <hr class="post-divider" />



      <!-- MDX – Post Content -->
      <div class="post-content">
        <slot />
      </div>

      <!-- Related Posts Section -->
      {relatedPosts.length > 0 && (
        <div class="related-posts-section">
          <h3 class="related-title">📖 You Might Also Like</h3>
          <div class="related-grid">
            {relatedPosts.map(rp => (
              <a href={`/blog/${rp.data.permalink || rp.slug}/`} class="related-card">
                {rp.data.image && (
                  <img src={rp.data.image} alt={rp.data.title} loading="lazy" />
                )}
                <h4>{rp.data.title}</h4>
              </a>
            ))}
          </div>
        </div>
      )}

      <hr class="post-divider" />

      <!-- Back to Posts -->
      <div class="post-footer-nav">
        <a href="/blog/" class="back-btn">← Back to All Posts</a>
      </div>
    </main>

    <!-- ── RIGHT SIDEBAR (Ads) ──────────────────────────────── -->
    <aside class="post-ad-col">
      <div class="ad-sticky">
        <AdSlot format="rectangle" />
        <div class="ad-spacer"></div>
        <AdSlot format="rectangle" />
      </div>
    </aside>

  </div><!-- /post-body -->
</BaseLayout>

<!-- ================================================================ -->
<!-- STYLES                                                            -->
<!-- ================================================================ -->


<!-- ============================================================ -->
<!-- MOBILE SIDEBAR JS                                            -->
<!-- ============================================================ -->
<script is:inline>
  (function () {
    const toggleBtn = document.getElementById('postSidebarToggle');
    const sidebar   = document.getElementById('postSidebar');
    if (!toggleBtn || !sidebar) return;

    // Inject close button at top of sidebar (only mobile)
    const closeRow = document.createElement('div');
    closeRow.className = 'sidebar-close-btn';
    closeRow.innerHTML = '<button id="sidebarCloseBtn">✕ Close</button>';
    sidebar.prepend(closeRow);

    // Inject overlay
    const overlay = document.createElement('div');
    overlay.className = 'sidebar-overlay';
    overlay.id = 'sidebarOverlay';
    document.body.appendChild(overlay);

    function openSidebar() {
      sidebar.classList.add('sidebar-open');
      overlay.classList.add('show');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebar.classList.remove('sidebar-open');
      overlay.classList.remove('show');
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', openSidebar);
    document.getElementById('sidebarCloseBtn').addEventListener('click', closeSidebar);
    overlay.addEventListener('click', closeSidebar);

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 769) closeSidebar();
    });
  })();
</script>

