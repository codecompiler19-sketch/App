  <div class="max-w-screen-2xl mx-auto px-5 sm:px-8 lg:px-10 py-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      <div class="cc-feature-card">
        <span class="cc-feature-icon blue" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 5h18v14H3z"/><path d="M6 8h2v8H6zm5 0h2v8h-2zm5 0h2v8h-2z" fill="#fff"/></svg>
        </span>
        <span><strong>Beginner Friendly</strong><small>Easy to follow guides</small></span>
      </div>
      <div class="cc-feature-card">
        <span class="cc-feature-icon green" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 19h16v2H4z"/><rect x="5" y="12" width="3.5" height="7" rx="1"/><rect x="10.25" y="8" width="3.5" height="11" rx="1"/><rect x="15.5" y="4" width="3.5" height="15" rx="1"/></svg>
        </span>
        <span><strong>Step-by-Step</strong><small>Learn with examples</small></span>
      </div>
      <div class="cc-feature-card">
        <span class="cc-feature-icon yellow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 19h6v1.5A1.5 1.5 0 0 1 13.5 22h-3A1.5 1.5 0 0 1 9 20.5V19Z"/><path d="M7.2 10.1A4.8 4.8 0 0 1 12 5.3a4.8 4.8 0 0 1 4.8 4.8c0 1.8-.8 3.2-2 4.3-.8.7-1.3 1.4-1.5 2.6h-2.6c-.2-1.2-.7-1.9-1.5-2.6a5.8 5.8 0 0 1-2-4.3Z"/><path d="M10 2.5v-1M17.7 4.3l.7-.7M21.5 10h1M6.3 4.3l-.7-.7M3.5 10h-1"/></svg>
        </span>
        <span><strong>Interview Ready</strong><small>Practice questions</small></span>
      </div>
      <div class="cc-feature-card">
        <span class="cc-feature-icon blue" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 5.5A2.5 2.5 0 0 1 5.5 3H11v16H5.5A2.5 2.5 0 0 0 3 21V5.5Z"/><path d="M21 5.5A2.5 2.5 0 0 0 18.5 3H13v16h5.5A2.5 2.5 0 0 1 21 21V5.5Z"/><path d="M12 4v16"/></svg>
        </span>
        <span><strong>All in One Place</strong><small>Tutorials, programs &amp; more</small></span>
      </div>
      <div class="cc-feature-card">
        <span class="cc-feature-icon orange" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14.7 3.2c2.6-.6 4.6.1 6.1 1.6 1.5 1.5 2.2 3.5 1.6 6.1l-4.8-4.8-2.6 2.6.7 3.2-2.4 2.4-3.2-.7-2.6 2.6 4.8 4.8c-2.6.6-4.6-.1-6.1-1.6-1.5-1.5-2.2-3.5-1.6-6.1l4.8 4.8 2.6-2.6-.7-3.2 2.4-2.4 3.2.7 2.6-2.6-4.8-4.8Z"/><circle cx="5.1" cy="18.9" r="1.4"/></svg>
        </span>
        <span><strong>Improve Your Skills</strong><small>From basics to advanced</small></span>
      </div>
    </div>
  </div>
</section>
{theme.showTutorialCategories !== false && (<section id="courses" class="relative w-full overflow-hidden bg-slate-50 py-20 sm:py-24 px-4 sm:px-6"><div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_15%_15%,rgba(59,130,246,0.08),transparent_28%),radial-gradient(circle_at_85%_25%,rgba(168,85,247,0.08),transparent_28%),radial-gradient(circle_at_70%_85%,rgba(16,185,129,0.07),transparent_30%)]"></div><div class="relative max-w-7xl mx-auto"><div class="max-w-3xl mx-auto text-center mb-12 sm:mb-14"><span class="inline-flex items-center rounded-full bg-blue-50 px-4 py-2 text-xs sm:text-sm font-bold tracking-[0.18em] text-blue-600 uppercase">Learn by Topics</span><h2 class="mt-5 text-4xl sm:text-5xl font-black tracking-tight text-slate-950" set:html={theme.coursesTitle || 'Explore Our <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-violet-600">Tutorial Library</span>'} /><p class="mt-4 text-base sm:text-lg leading-7 text-slate-500" set:html={theme.coursesSubtitle || 'Step-by-step guides, real examples, and practical projects to help you learn web development and programming skills for free.'} /></div><div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-6 gap-5 sm:gap-6">
  
