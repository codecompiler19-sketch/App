<script is:inline>
  const heroForm = document.getElementById('hero-search-form');
  const heroInput = document.getElementById('hero-search');
  heroForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const main = document.getElementById('main-search');
    if (main && heroInput) {
      main.value = heroInput.value;
      main.dispatchEvent(new Event('input', { bubbles: true }));
      main.focus();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  const heroSlides = Array.from(document.querySelectorAll('.cc-hero-slide'));
  const heroDots = Array.from(document.querySelectorAll('[data-slide-dot]'));
  const heroPrev = document.querySelector('[data-slider-prev]');
  const heroNext = document.querySelector('[data-slider-next]');
  const heroRoot = document.getElementById('cc-home-hero');
  let heroIndex = 0;
  let heroTimer;

  function showHeroSlide(index, restart = true) {
    heroIndex = (index + heroSlides.length) % heroSlides.length;
    heroSlides.forEach((slide, i) => {
      const active = i === heroIndex;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', String(!active));
    });
    heroRoot?.classList.toggle('cc-hero-dark', heroIndex !== 0);
    heroRoot?.classList.remove('cc-slide-2','cc-slide-3','cc-slide-4','cc-slide-5','cc-slide-6');
    if (heroIndex > 0) heroRoot?.classList.add(`cc-slide-${heroIndex + 1}`);
    heroDots.forEach((dot, i) => {
      const active = i === heroIndex;
      dot.classList.toggle('active', active);
      dot.setAttribute('aria-selected', String(active));
    });
    if (restart) startHeroTimer();
  }

  function startHeroTimer() {
    clearInterval(heroTimer);
    heroTimer = window.setInterval(() => showHeroSlide(heroIndex + 1, false), 6500);
  }

  heroPrev?.addEventListener('click', () => showHeroSlide(heroIndex - 1));
  heroNext?.addEventListener('click', () => showHeroSlide(heroIndex + 1));
  heroDots.forEach((dot) => dot.addEventListener('click', () => showHeroSlide(Number(dot.dataset.slideDot))));

  heroRoot?.addEventListener('mouseenter', () => clearInterval(heroTimer));
  heroRoot?.addEventListener('mouseleave', startHeroTimer);
  heroRoot?.addEventListener('focusin', () => clearInterval(heroTimer));
  heroRoot?.addEventListener('focusout', () => {
    if (!heroRoot.contains(document.activeElement)) startHeroTimer();
  });

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) startHeroTimer();
</script>
