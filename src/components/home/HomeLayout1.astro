---
import { getCollection } from 'astro:content';
import themeRaw from '../../theme-settings.json';

const theme = themeRaw || {};
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const CATEGORY_COLORS: Record<string, { color: string; bg: string }> = {
  'HTML & CSS':           { color: '#E34F26', bg: '#fff4f0' },
  'JavaScript':           { color: '#ca8a04', bg: '#fefce8' },
  'HTML CSS JavaScript':  { color: '#04AA6D', bg: '#f0fff8' },
};
---

<section class="cc-home-hero relative w-full overflow-hidden">
  <div class="cc-hero-glow cc-hero-glow-a"></div>
  <div class="cc-hero-glow cc-hero-glow-b"></div>
  <div class="relative z-10 max-w-screen-2xl mx-auto px-5 sm:px-8 lg:px-12 py-12 sm:py-16 lg:py-20">
    <div class="grid lg:grid-cols-[1.03fr_.97fr] gap-10 lg:gap-4 items-center">
      <div class="max-w-3xl">
        <p class="cc-hero-kicker">FREE PROGRAMMING TUTORIALS</p>
        <h1 class="cc-hero-title">Learn to Code with<br/><span>Step-by-Step</span> Tutorials</h1>
        <p class="cc-hero-copy">Free programming tutorials, examples, definitions, interview questions and more. Learn HTML, CSS, JavaScript, Python, SQL, PHP and SEO with easy-to-follow guides.</p>
        <form id="hero-search-form" class="cc-hero-search" role="search">
          <span class="cc-hero-search-icon" aria-hidden="true">⌕</span>
          <input id="hero-search" type="search" autocomplete="off" placeholder="Search tutorials, examples, questions..." aria-label="Search tutorials, examples and questions" />
          <button type="submit">⌕ <span>Search</span></button>
        </form>
        <div class="cc-hero-benefits">
          <div><span class="cc-benefit-icon cc-benefit-green">◆</span><span><strong>Free</strong><small>Tutorials</small></span></div>
          <div><span class="cc-benefit-icon cc-benefit-blue">&lt;/&gt;</span><span><strong>Practical</strong><small>Examples</small></span></div>
          <div><span class="cc-benefit-icon cc-benefit-purple">▤</span><span><strong>Interview</strong><small>Questions</small></span></div>
          <div><span class="cc-benefit-icon cc-benefit-orange">▤</span><span><strong>Detailed</strong><small>Explanations</small></span></div>
        </div>
      </div>

      <div class="cc-hero-visual" aria-label="Coding workspace illustration">
        <div class="cc-code-orbit cc-orbit-html"><b>5</b><span>HTML</span></div>
        <div class="cc-code-orbit cc-orbit-css"><b>3</b><span>CSS</span></div>
        <div class="cc-code-orbit cc-orbit-js"><b>JS</b><span>JavaScript</span></div>
        <div class="cc-code-orbit cc-orbit-py"><b>Py</b><span>Python</span></div>
        <div class="cc-code-orbit cc-orbit-sql"><b>DB</b><span>SQL</span></div>
        <div class="cc-code-orbit cc-orbit-php"><b>php</b><span>PHP</span></div>
        <div class="cc-code-orbit cc-orbit-seo"><b>↗</b><span>SEO</span></div>

        <div class="cc-laptop">
          <div class="cc-laptop-screen">
            <div class="cc-editor-top"><i></i><i></i><i></i><span>index.html</span></div>
            <div class="cc-editor-code">
              <div><em>1</em><span><b>&lt;!DOCTYPE</b> html&gt;</span></div>
              <div><em>2</em><span><b>&lt;html</b> lang=<mark>"en"</mark>&gt;</span></div>
              <div><em>3</em><span><b>&lt;head&gt;</b></span></div>
              <div><em>4</em><span>&nbsp;&nbsp;&lt;meta charset=<mark>"UTF-8"</mark>&gt;</span></div>
              <div><em>5</em><span>&nbsp;&nbsp;&lt;title&gt;<strong>CodesCompiler</strong>&lt;/title&gt;</span></div>
              <div><em>6</em><span><b>&lt;/head&gt;</b></span></div>
              <div><em>7</em><span><b>&lt;body&gt;</b></span></div>
              <div><em>8</em><span>&nbsp;&nbsp;&lt;h1&gt;<strong>Learn Coding</strong>&lt;/h1&gt;</span></div>
              <div><em>9</em><span>&nbsp;&nbsp;&lt;p&gt;Build your skills step by step.&lt;/p&gt;</span></div>
              <div><em>10</em><span><b>&lt;/body&gt;</b></span></div>
              <div><em>11</em><span><b>&lt;/html&gt;</b></span></div>
            </div>
          </div>
          <div class="cc-laptop-base"></div>
        </div>
      </div>
    </div>
    <div class="cc-slider-controls" aria-label="Hero slider">
      <button type="button" aria-label="Previous slide">‹</button>
      <span class="active"></span><span></span><span></span><span></span><span></span>
      <button type="button" aria-label="Next slide">›</button>
    </div>
  </div>
</section>

<section class="cc-feature-strip" aria-label="CodesCompiler features">
  <div class="max-w-screen-2xl mx-auto px-5 sm:px-8 lg:px-10 py-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      <div class="cc-feature-card"><span class="cc-feature-icon blue">&lt;/&gt;</span><span><strong>Beginner Friendly</strong><small>Easy to follow guides</small></span></div>
      <div class="cc-feature-card"><span class="cc-feature-icon green">▮▮▮</span><span><strong>Step-by-Step</strong><small>Learn with examples</small></span></div>
      <div class="cc-feature-card"><span class="cc-feature-icon yellow">◆</span><span><strong>Interview Ready</strong><small>Practice questions</small></span></div>
      <div class="cc-feature-card"><span class="cc-feature-icon blue">▤</span><span><strong>All in One Place</strong><small>Tutorials, programs &amp; more</small></span></div>
      <div class="cc-feature-card"><span class="cc-feature-icon orange">➜</span><span><strong>Improve Your Skills</strong><small>From basics to advanced</small></span></div>
    </div>
  </div>
</section>
{theme.showTutorialCategories !== false && (<section id="courses" class="relative w-full overflow-hidden bg-slate-50 py-20 sm:py-24 px-4 sm:px-6"><div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_15%_15%,rgba(59,130,246,0.08),transparent_28%),radial-gradient(circle_at_85%_25%,rgba(168,85,247,0.08),transparent_28%),radial-gradient(circle_at_70%_85%,rgba(16,185,129,0.07),transparent_30%)]"></div><div class="relative max-w-7xl mx-auto"><div class="max-w-3xl mx-auto text-center mb-12 sm:mb-14"><span class="inline-flex items-center rounded-full bg-blue-50 px-4 py-2 text-xs sm:text-sm font-bold tracking-[0.18em] text-blue-600 uppercase">Learn by Topics</span><h2 class="mt-5 text-4xl sm:text-5xl font-black tracking-tight text-slate-950" set:html={theme.coursesTitle || 'Explore Our <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-violet-600">Tutorial Library</span>'} /><p class="mt-4 text-base sm:text-lg leading-7 text-slate-500" set:html={theme.coursesSubtitle || 'Step-by-step guides, real examples, and practical projects to help you learn web development and programming skills for free.'} /></div><div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-6 gap-5 sm:gap-6">
  
