---
import { getCollection } from 'astro:content';
import themeRaw from '../../theme-settings.json';

const theme = themeRaw || {};
const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const CATEGORY_COLORS: Record<string, { color: string; bg: string }> = {
  'HTML & CSS':           { color: '#E34F26', bg: '#fff4f0' },
  'JavaScript':           { color: '#ca8a04', bg: '#fefce8' },
  'HTML CSS JavaScript':  { color: '#04AA6D', bg: '#f0fff8' },
};
---

<section class="cc-home-hero relative w-full overflow-hidden" id="cc-home-hero">
  <div class="cc-hero-glow cc-hero-glow-a"></div>
  <div class="cc-hero-glow cc-hero-glow-b"></div>
  <div class="relative z-10 max-w-screen-2xl mx-auto px-5 sm:px-8 lg:px-12 py-12 sm:py-16 lg:py-20">
    <div class="cc-hero-slider-stage">

      <!-- Slide 1: Learn to Code -->
      <article class="cc-hero-slide is-active" data-slide="0" aria-hidden="false">
        <div class="grid lg:grid-cols-[1.03fr_.97fr] gap-10 lg:gap-4 items-center">
          <div class="max-w-3xl">
            <p class="cc-hero-kicker">FREE PROGRAMMING TUTORIALS</p>
            <h1 class="cc-hero-title">Learn to Code with<br/><span>Step-by-Step</span> Tutorials</h1>
            <p class="cc-hero-copy">Free programming tutorials, examples, definitions, interview questions and more. Learn HTML, CSS, JavaScript, Python, SQL, PHP and SEO with easy-to-follow guides.</p>
            <form id="hero-search-form" class="cc-hero-search" role="search">
              <span class="cc-hero-search-icon" aria-hidden="true">⌕</span>
              <input id="hero-search" type="search" autocomplete="off" placeholder="Search tutorials, examples, questions..." aria-label="Search tutorials, examples and questions" />
              <button type="submit">⌕ <span>Search</span></button>
            </form>
            <div class="cc-hero-benefits">
              <div><span class="cc-benefit-icon cc-benefit-green">◆</span><span><strong>Free</strong><small>Tutorials</small></span></div>
              <div><span class="cc-benefit-icon cc-benefit-blue">&lt;/&gt;</span><span><strong>Practical</strong><small>Examples</small></span></div>
              <div><span class="cc-benefit-icon cc-benefit-purple">▤</span><span><strong>Interview</strong><small>Questions</small></span></div>
              <div><span class="cc-benefit-icon cc-benefit-orange">▤</span><span><strong>Detailed</strong><small>Explanations</small></span></div>
            </div>
          </div>
          <div class="cc-hero-visual" aria-label="Coding workspace illustration">
            <div class="cc-code-orbit cc-orbit-html"><b class="cc-orbit-logo cc-orbit-html-logo">HTML</b><span>HTML</span></div>
            <div class="cc-code-orbit cc-orbit-css"><b class="cc-orbit-logo cc-orbit-css-logo">CSS</b><span>CSS</span></div>
            <div class="cc-code-orbit cc-orbit-js"><b>JS</b><span>JavaScript</span></div>
            <div class="cc-code-orbit cc-orbit-py"><b>Py</b><span>Python</span></div>
            <div class="cc-code-orbit cc-orbit-sql"><b>DB</b><span>SQL</span></div>
            <div class="cc-code-orbit cc-orbit-php"><b>php</b><span>PHP</span></div>
            <div class="cc-code-orbit cc-orbit-seo"><b>↗</b><span>SEO</span></div>
            <div class="cc-laptop">
              <div class="cc-laptop-screen">
                <div class="cc-editor-top"><i></i><i></i><i></i><span>index.html</span></div>
                <div class="cc-editor-code">
                  <div><em>1</em><span><b>&lt;!DOCTYPE</b> html&gt;</span></div>
                  <div><em>2</em><span><b>&lt;html</b> lang=<mark>"en"</mark>&gt;</span></div>
                  <div><em>3</em><span><b>&lt;head&gt;</b></span></div>
                  <div><em>4</em><span>&nbsp;&nbsp;&lt;meta charset=<mark>"UTF-8"</mark>&gt;</span></div>
                  <div><em>5</em><span>&nbsp;&nbsp;&lt;title&gt;<strong>CodesCompiler</strong>&lt;/title&gt;</span></div>
                  <div><em>6</em><span><b>&lt;/head&gt;</b></span></div>
                  <div><em>7</em><span><b>&lt;body&gt;</b></span></div>
                  <div><em>8</em><span>&nbsp;&nbsp;&lt;h1&gt;<strong>Learn Coding</strong>&lt;/h1&gt;</span></div>
                  <div><em>9</em><span>&nbsp;&nbsp;&lt;p&gt;Build your skills step by step.&lt;/p&gt;</span></div>
                  <div><em>10</em><span><b>&lt;/body&gt;</b></span></div>
                  <div><em>11</em><span><b>&lt;/html&gt;</b></span></div>
                </div>
              </div>
              <div class="cc-laptop-base"></div>
            </div>
          </div>
        </div>
      </article>

      <!-- Slide 2: Practice With Real Code -->
      <article class="cc-hero-slide" data-slide="1" aria-hidden="true">
        <div class="grid lg:grid-cols-[1.03fr_.97fr] gap-10 lg:gap-4 items-center">
          <div class="max-w-3xl">
            <p class="cc-hero-kicker">PRACTICE WHILE YOU LEARN</p>
            <h2 class="cc-hero-title">Don't Just Read Code.<br/><span>Practice It.</span></h2>
            <p class="cc-hero-copy">Turn every concept into hands-on practice. Write code, run examples, and see the result immediately as you learn.</p>
            <div class="cc-hero-pills">
              <span>✦ Write Code</span><span>▶ Run Examples</span><span>✓ See Results</span>
            </div>
            <a href="/tutorials/" class="cc-hero-cta">Start Practicing <b>→</b></a>
          </div>
          <div class="cc-slide-visual cc-practice-visual" aria-label="Interactive coding editor illustration">
            <div class="cc-practice-window">
              <div class="cc-practice-bar"><i></i><i></i><i></i><span>try-it-yourself.html</span></div>
              <div class="cc-practice-body">
                <div class="cc-practice-editor">
                  <small>HTML</small>
                  <pre><code>&lt;h1&gt;Hello, World!&lt;/h1&gt;
&lt;p&gt;I am learning to code.&lt;/p&gt;</code></pre>
                  <button type="button">▶ Run Code</button>
                </div>
                <div class="cc-practice-output">
                  <small>OUTPUT</small>
                  <div class="cc-output-paper"><h3>Hello, World!</h3><p>I am learning to code.</p><span class="cc-cursor"></span></div>
                </div>
              </div>
            </div>
            <div class="cc-float-chip cc-chip-run">▶ Instant Output</div>
            <div class="cc-float-chip cc-chip-free">✓ Free to Practice</div>
          </div>
        </div>
      </article>

      <!-- Slide 3: Build Real Projects -->
      <article class="cc-hero-slide" data-slide="2" aria-hidden="true">
        <div class="grid lg:grid-cols-[1.03fr_.97fr] gap-10 lg:gap-4 items-center">
          <div class="max-w-3xl">
            <p class="cc-hero-kicker">LEARN BY BUILDING</p>
            <h2 class="cc-hero-title">Learn Coding by Building<br/><span>Real Projects</span></h2>
            <p class="cc-hero-copy">Move from simple examples to useful projects. Build websites and JavaScript apps that turn your knowledge into practical skills.</p>
            <div class="cc-project-stats"><div><strong>HTML</strong><small>Web Pages</small></div><div><strong>CSS</strong><small>Beautiful UI</small></div><div><strong>JS</strong><small>Interactive Apps</small></div></div>
            <a href="/programs/" class="cc-hero-cta">Explore Programs <b>→</b></a>
          </div>
          <div class="cc-slide-visual cc-project-visual" aria-label="Coding projects illustration">
            <div class="cc-project-board">
              <div class="cc-project-header"><span>My Coding Projects</span><b>+ New Project</b></div>
              <div class="cc-project-grid">
                <div class="cc-project-card orange"><span>⌗</span><strong>Portfolio</strong><small>HTML + CSS</small><em>Completed ✓</em></div>
                <div class="cc-project-card blue"><span>◫</span><strong>Calculator</strong><small>JavaScript</small><em>Build next →</em></div>
                <div class="cc-project-card purple"><span>◷</span><strong>Pomodoro</strong><small>JavaScript</small><em>Practice</em></div>
                <div class="cc-project-card green"><span>✓</span><strong>To-Do App</strong><small>JS + Local Storage</small><em>Challenge yourself</em></div>
              </div>
            </div>
            <div class="cc-project-code">&lt;build&gt; <b>something useful</b> &lt;/build&gt;</div>
          </div>
        </div>
      </article>

      <!-- Slide 4: Interview Preparation -->
      <article class="cc-hero-slide" data-slide="3" aria-hidden="true">
        <div class="grid lg:grid-cols-[1.03fr_.97fr] gap-10 lg:gap-4 items-center">
          <div class="max-w-3xl">
            <p class="cc-hero-kicker">INTERVIEW PREPARATION</p>
            <h2 class="cc-hero-title">Prepare for Your Next<br/><span>Coding Interview</span></h2>
            <p class="cc-hero-copy">Practice the questions developers are asked most often. Review concepts, strengthen your answers, and prepare topic by topic.</p>
            <div class="cc-interview-tags"><span>HTML</span><span>CSS</span><span>JavaScript</span><span>Python</span><span>SQL</span></div>
            <a href="/interview-questions/" class="cc-hero-cta">Practice Interview Questions <b>→</b></a>
          </div>
          <div class="cc-slide-visual cc-interview-visual" aria-label="Coding interview questions illustration">
            <div class="cc-interview-panel">
              <div class="cc-interview-top"><span>Interview Practice</span><b>Question 24 / 100</b></div>
              <div class="cc-question"><small>JAVASCRIPT</small><h3>What is a closure in JavaScript?</h3><div class="cc-answer-line"><b>A</b><span>A function bundled with its lexical environment.</span></div><div class="cc-answer-line"><b>B</b><span>A loop that never ends.</span></div><div class="cc-answer-line"><b>C</b><span>A CSS property.</span></div></div>
              <div class="cc-interview-footer"><span>● Concept</span><span>● Interview Tip</span><span>● Example</span></div>
            </div>
            <div class="cc-score-card"><strong>85%</strong><span>Ready to improve</span></div>
          </div>
        </div>
      </article>

      <!-- Slide 5: Beginner to Advanced -->
      <article class="cc-hero-slide" data-slide="4" aria-hidden="true">
        <div class="grid lg:grid-cols-[1.03fr_.97fr] gap-10 lg:gap-4 items-center">
          <div class="max-w-3xl">
            <p class="cc-hero-kicker">YOUR LEARNING JOURNEY</p>
            <h2 class="cc-hero-title">Start as a Beginner.<br/><span>Grow With Confidence.</span></h2>
            <p class="cc-hero-copy">Follow a clear path from fundamentals to advanced concepts. Learn one step at a time without getting lost.</p>
            <div class="cc-path-points"><span>01 Fundamentals</span><span>02 Programming</span><span>03 Data &amp; Logic</span><span>04 Advanced Skills</span></div>
            <a href="/tutorials/" class="cc-hero-cta">Start Your Journey <b>→</b></a>
          </div>
          <div class="cc-slide-visual cc-roadmap-visual" aria-label="Learning roadmap illustration">
            <div class="cc-roadmap">
              <div class="cc-roadmap-line"></div>
              <div class="cc-road-step done"><b>01</b><span>HTML &amp; CSS</span><small>Build the foundation</small></div>
              <div class="cc-road-step active"><b>02</b><span>JavaScript</span><small>Make it interactive</small></div>
              <div class="cc-road-step"><b>03</b><span>Python &amp; SQL</span><small>Go deeper</small></div>
              <div class="cc-road-step"><b>04</b><span>Programs &amp; CS</span><small>Level up</small></div>
            </div>
            <div class="cc-level-badge">BEGINNER → ADVANCED</div>
          </div>
        </div>
      </article>

      <!-- Slide 6: Complete Coding Resources -->
      <article class="cc-hero-slide" data-slide="5" aria-hidden="true">
        <div class="grid lg:grid-cols-[1.03fr_.97fr] gap-10 lg:gap-4 items-center">
          <div class="max-w-3xl">
            <p class="cc-hero-kicker">YOUR CODING RESOURCE HUB</p>
            <h2 class="cc-hero-title">Everything You Need to<br/><span>Become a Better Developer</span></h2>
            <p class="cc-hero-copy">Learn, practice, prepare, and find quick answers — all in one place with free resources for developers at every level.</p>
            <div class="cc-resource-pills"><span>📚 Tutorials</span><span>💻 Programs</span><span>🧠 Interviews</span><span>📖 Definitions</span></div>
            <a href="/about/" class="cc-hero-cta">Explore CodesCompiler <b>→</b></a>
          </div>
          <div class="cc-slide-visual cc-resource-visual" aria-label="CodesCompiler resource dashboard illustration">
            <div class="cc-resource-dashboard">
              <div class="cc-dashboard-top"><span>CodesCompiler</span><b>Developer Hub</b></div>
              <div class="cc-resource-grid">
                <div><strong>📚</strong><b>Tutorials</b><small>Step-by-step learning</small></div>
                <div><strong>💻</strong><b>Programs</b><small>Practical examples</small></div>
                <div><strong>🧠</strong><b>Interviews</b><small>Prepare with questions</small></div>
                <div><strong>📖</strong><b>Definitions</b><small>Quick explanations</small></div>
                <div><strong>📰</strong><b>Blog</b><small>Tips &amp; guides</small></div>
                <div><strong>🔎</strong><b>Search</b><small>Find it faster</small></div>
              </div>
            </div>
            <div class="cc-resource-ribbon">LEARN • PRACTICE • BUILD • GROW</div>
          </div>
        </div>
      </article>

    </div>

    <div class="cc-slider-controls" aria-label="Hero slider controls">
      <button type="button" data-slider-prev aria-label="Previous slide">‹</button>
      <div class="cc-slider-dots" role="tablist" aria-label="Select hero slide">
        <button type="button" class="active" data-slide-dot="0" aria-label="Go to slide 1" aria-selected="true"></button>
        <button type="button" data-slide-dot="1" aria-label="Go to slide 2" aria-selected="false"></button>
        <button type="button" data-slide-dot="2" aria-label="Go to slide 3" aria-selected="false"></button>
        <button type="button" data-slide-dot="3" aria-label="Go to slide 4" aria-selected="false"></button>
        <button type="button" data-slide-dot="4" aria-label="Go to slide 5" aria-selected="false"></button>
        <button type="button" data-slide-dot="5" aria-label="Go to slide 6" aria-selected="false"></button>
      </div>
      <button type="button" data-slider-next aria-label="Next slide">›</button>
    </div>
  </div>
</section>

