{theme.showFeaturedSection !== false && (
<section class="relative w-full overflow-hidden bg-white py-20 sm:py-24 px-4 sm:px-6 border-t border-slate-100">
  <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_10%_20%,rgba(59,130,246,0.10),transparent_24%),radial-gradient(circle_at_88%_18%,rgba(168,85,247,0.10),transparent_24%),radial-gradient(circle_at_50%_95%,rgba(16,185,129,0.08),transparent_28%)]"></div>
  <div class="relative max-w-7xl mx-auto">
    <div class="max-w-3xl mx-auto text-center mb-10 sm:mb-12">
      <span class="inline-flex items-center rounded-full border border-blue-100 bg-blue-50 px-4 py-2 text-xs sm:text-sm font-bold tracking-[0.18em] text-blue-600 uppercase">Why Choose Us</span>
      <h2 class="mt-5 text-4xl sm:text-5xl font-black tracking-tight text-slate-950" set:html={theme.featuresTitle || 'Why <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-violet-600">Learn With Us?</span>'} />
      <p class="mt-4 text-base sm:text-lg leading-7 text-slate-500" set:html={theme.featuresSubtitle || 'Everything you need to master web development.'} />
