---
import BaseLayout from '../layouts/BaseLayout.astro';

const programs = [
  { title: 'HTML Programs', text: 'Practice HTML with small examples and page-building exercises.', href: '/tutorial/html-introduction/' },
  { title: 'CSS Programs', text: 'Practice layouts, buttons, cards, navigation and responsive styles.', href: '/tutorial/css-introduction/' },
  { title: 'JavaScript Programs', text: 'Solve JavaScript problems and build interactive features.', href: '/tutorial/javascript-introduction/' },
  { title: 'Python Programs', text: 'Practice Python fundamentals, logic and problem solving.', href: '/tutorial/python-introduction/' },
  { title: 'SQL Programs', text: 'Practice database queries, filtering, sorting and joins.', href: '/tutorial/sql-introduction/' },
  { title: 'Computer Science', text: 'Explore algorithms, data structures, operating systems and DBMS.', href: '/cs-basics/programming-basics/' },
];
---

<BaseLayout title="Programming Programs" description="Practice programming with coding examples and programs for HTML, CSS, JavaScript, Python, SQL and computer science.">
  <section class="hero"><span>CODING PRACTICE</span><h1>Programming Programs</h1><p>Practice coding concepts with simple programs and examples.</p></section>
  <main class="wrap">
    <h2>Explore Programs</h2>
    <p class="lead">Choose a programming area and start practicing.</p>
    <div class="grid">
      {programs.map(item => (
        <a class="card" href={item.href}>
          <div class="icon">&lt;/&gt;</div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <strong>Explore →</strong>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
.hero{background:linear-gradient(135deg,#10243d,#173d67);color:#fff;text-align:center;padding:56px 20px}.hero span{color:#f5b900;font-size:.78rem;font-weight:800;letter-spacing:.12em}.hero h1{font-size:clamp(2rem,4vw,3rem);margin:12px 0}.hero p{color:#dbe7f5;font-size:1.08rem}.wrap{max-width:1120px;margin:auto;padding:44px 20px 70px}.wrap>h2{text-align:center;color:#10243d;font-size:1.8rem;margin:0 0 6px}.lead{text-align:center;color:#64748b;margin-bottom:28px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{padding:24px;border:1px solid #e2e8f0;border-radius:16px;background:#fff;text-decoration:none;box-shadow:0 3px 12px rgba(15,23,42,.05);transition:.2s}.card:hover{transform:translateY(-4px);box-shadow:0 12px 30px rgba(15,23,42,.12)}.icon{width:48px;height:48px;border-radius:10px;background:#10243d;color:#f5b900;display:grid;place-items:center;font-weight:800;font-family:monospace;margin-bottom:16px}.card h3{color:#10243d;font-size:1.2rem;margin:0 0 8px}.card p{color:#64748b;line-height:1.55;min-height:50px}.card strong{color:#0f766e}@media(max-width:800px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.grid{grid-template-columns:1fr}}
</style>
