---
import BaseLayout from '../layouts/BaseLayout.astro';

const topics = [
  ['HTML Interview Questions','HTML elements, forms, semantic HTML, accessibility and common interview concepts.','/tutorial/html-introduction/'],
  ['CSS Interview Questions','Selectors, box model, flexbox, grid, positioning and responsive design.','/tutorial/css-introduction/'],
  ['JavaScript Interview Questions','Variables, functions, arrays, objects, DOM, events and modern JavaScript.','/tutorial/javascript-introduction/'],
  ['Python Interview Questions','Python basics, data types, functions, OOP and problem-solving concepts.','/tutorial/python-introduction/'],
  ['SQL Interview Questions','Queries, joins, grouping, subqueries, indexes and database concepts.','/tutorial/sql-introduction/'],
  ['Computer Science Questions','Algorithms, data structures, operating systems, DBMS and networking.','/cs-basics/programming-basics/'],
];
---

<BaseLayout title="Interview Questions" description="Programming and computer science interview questions for HTML, CSS, JavaScript, Python, SQL and core computer science topics.">
  <section class="hero"><span>INTERVIEW PREPARATION</span><h1>Interview Questions</h1><p>Prepare for technical interviews with focused programming and computer science topics.</p></section>
  <main class="wrap">
    <h2>Choose a Topic</h2>
    <div class="grid">
      {topics.map(([title,text,href]) => (
        <a class="card" href={href}>
          <div class="num">Q</div>
          <h3>{title}</h3>
          <p>{text}</p>
          <strong>Prepare now →</strong>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
.hero{background:linear-gradient(135deg,#10243d,#173d67);color:#fff;text-align:center;padding:56px 20px}.hero span{color:#f5b900;font-size:.78rem;font-weight:800;letter-spacing:.12em}.hero h1{font-size:clamp(2rem,4vw,3rem);margin:12px 0}.hero p{color:#dbe7f5;font-size:1.08rem}.wrap{max-width:1120px;margin:auto;padding:44px 20px 70px}.wrap h2{text-align:center;color:#10243d;font-size:1.8rem;margin:0 0 28px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{padding:24px;border:1px solid #e2e8f0;border-radius:16px;background:#fff;text-decoration:none;box-shadow:0 3px 12px rgba(15,23,42,.05);transition:.2s}.card:hover{transform:translateY(-4px);box-shadow:0 12px 30px rgba(15,23,42,.12)}.num{width:48px;height:48px;border-radius:50%;background:#fef3c7;color:#b45309;display:grid;place-items:center;font-weight:900;margin-bottom:16px}.card h3{color:#10243d;font-size:1.2rem;margin:0 0 8px}.card p{color:#64748b;line-height:1.55}.card strong{color:#0f766e}@media(max-width:800px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.grid{grid-template-columns:1fr}}
</style>
