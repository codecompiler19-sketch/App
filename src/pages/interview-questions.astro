---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';

const languages = [
  ['HTML', '/interview-questions/html/'], ['CSS', '/interview-questions/css/'],
  ['JavaScript', '/interview-questions/javascript/'], ['Python', '/interview-questions/python/'],
  ['SQL', '/interview-questions/sql/'], ['PHP', '/interview-questions/php/'],
  ['Computer Science', '/interview-questions/computer-science/'],
];
const tutorials = [
  ['HTML Tutorials', '/tutorial/html-introduction/'], ['CSS Tutorials', '/tutorial/css-introduction/'],
  ['JavaScript Tutorials', '/tutorial/javascript-introduction/'], ['Python Tutorials', '/tutorial/python-introduction/'],
  ['SQL Tutorials', '/tutorial/sql-introduction/'], ['PHP Tutorials', '/tutorial/php-introduction/'],
];
const featured = [
  ['HTML Interview Questions', 'Questions on semantic HTML, forms, accessibility, media and document structure.', '/interview-questions/html/'],
  ['CSS Interview Questions', 'Questions on selectors, the box model, Flexbox, Grid, animations and responsive layouts.', '/interview-questions/css/'],
  ['JavaScript Interview Questions', 'Questions on core language concepts, functions, arrays, objects, DOM and async JavaScript.', '/interview-questions/javascript/'],
  ['Python Interview Questions', 'Questions on syntax, collections, functions, exceptions, modules and object-oriented Python.', '/interview-questions/python/'],
  ['SQL Interview Questions', 'Questions on queries, joins, aggregation, subqueries, indexes and database design.', '/interview-questions/sql/'],
  ['PHP Interview Questions', 'Questions on PHP syntax, arrays, functions, forms, sessions and object-oriented programming.', '/interview-questions/php/'],
  ['Computer Science Questions', 'Questions on data structures, algorithms, operating systems, networking and DBMS.', '/interview-questions/computer-science/'],
];
---
<BaseLayout title="Programming Interview Questions" description="Explore programming interview questions for HTML, CSS, JavaScript, Python, SQL, PHP and computer science.">
  <section class="hero"><div class="hero-inner"><span>INTERVIEW PREPARATION</span><h1>Programming Interview Questions</h1><p>Prepare for technical interviews with organized question banks for popular programming languages and core computer science.</p></div></section>
  <main class="layout">
    <aside class="sidebar" aria-label="Interview question navigation">
      <div class="side-card"><h2>Programming Languages</h2><nav aria-label="Programming languages">{languages.map(([name, href]) => <a href={href}>{name}</a>)}</nav></div>
      <div class="side-card"><h2>Tutorials</h2><nav aria-label="Tutorials">{tutorials.map(([name, href]) => <a href={href}>{name}</a>)}</nav></div>
    </aside>
    <section class="content"><div class="intro"><span class="eyebrow">QUESTION LIBRARY</span><h2>Choose a Topic</h2><p>Explore interview questions from fundamentals to practical and advanced concepts. Select a language to browse its question collection.</p></div>
      <div class="topic-grid">{featured.map(([title, text, href], index) => <a class="topic-card" href={href}><div class="card-top"><span class="count">Interview Practice</span></div><h3>{title}</h3><p>{text}</p><strong>View Questions →</strong></a>)}</div>
    </section>
    <aside class="ads" aria-label="Advertisements"><AdSlot format="vertical" /><AdSlot format="rectangle" /></aside>
  </main>
</BaseLayout>
<style>
.hero{background:linear-gradient(135deg,#10243d,#173d67);color:#fff;padding:48px 20px}.hero-inner{max-width:1360px;margin:auto}.hero span,.eyebrow{display:block;color:#f5b900;font-size:.75rem;font-weight:800;letter-spacing:.12em}.hero h1{font-size:clamp(2rem,4vw,2.8rem);margin:10px 0}.hero p{color:#dbe7f5;max-width:780px;line-height:1.6;margin:0}.layout{max-width:1360px;margin:auto;padding:32px 20px 70px;display:grid;grid-template-columns:220px minmax(0,1fr) 180px;gap:24px;align-items:start}.sidebar,.ads{position:sticky;top:18px}.side-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:16px;margin-bottom:18px;box-shadow:0 3px 12px rgba(15,23,42,.05)}.side-card h2{font-size:.9rem;color:#10243d;margin:0 0 10px;padding-bottom:10px;border-bottom:1px solid #e2e8f0}.side-card nav{display:flex;flex-direction:column;gap:3px}.side-card a{color:#475569;text-decoration:none;padding:8px 9px;border-radius:7px;font-size:.9rem}.side-card a:hover{background:#fff7d6;color:#8a5a00;font-weight:700}.content{min-width:0}.intro{margin:4px 0 22px}.intro h2{font-size:1.75rem;color:#10243d;margin:7px 0}.intro p{color:#64748b;line-height:1.6;margin:0}.topic-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.topic-card{display:block;padding:21px;border:1px solid #e2e8f0;border-radius:12px;background:#fff;text-decoration:none;box-shadow:0 2px 10px rgba(15,23,42,.04);transition:.2s}.topic-card:hover{transform:translateY(-2px);border-color:#eab308;box-shadow:0 8px 22px rgba(15,23,42,.08)}.card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}.count{font-size:.75rem;font-weight:700;color:#8a5a00;background:#fef3c7;padding:5px 8px;border-radius:999px}.topic-card h3{color:#10243d;font-size:1.08rem;margin:0 0 7px}.topic-card p{color:#64748b;font-size:.9rem;line-height:1.5;margin:0 0 14px}.topic-card strong{color:#8a5a00;font-size:.88rem}.ads{display:flex;flex-direction:column;gap:20px;align-items:center}@media(max-width:1050px){.layout{grid-template-columns:200px minmax(0,1fr)}.ads{display:none}}@media(max-width:700px){.layout{grid-template-columns:1fr;padding:22px 14px 50px}.sidebar{position:static;display:grid;grid-template-columns:1fr 1fr;gap:12px}.side-card{margin:0}.topic-grid{grid-template-columns:1fr}.hero{padding:36px 16px}}@media(max-width:480px){.sidebar{grid-template-columns:1fr}.side-card nav{display:grid;grid-template-columns:1fr 1fr}}
</style>
