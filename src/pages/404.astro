---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you are looking for could not be found.">
  <main class="error-page">
    <div class="error-code">404</div>
    <h1>Page Not Found</h1>
    <p>Sorry, the page you are looking for does not exist or may have moved.</p>
    <div class="actions">
      <a class="home-btn" href="/">Go to Homepage</a>
      <a class="back-btn" href="javascript:history.back()">Go Back</a>
    </div>
    <p class="redirect">You will be redirected to the homepage in <strong id="countdown">5</strong> seconds.</p>
  </main>
</BaseLayout>

<script is:inline>
  let seconds = 5;
  const countdown = document.getElementById('countdown');
  const timer = setInterval(() => {
    seconds -= 1;
    if (countdown) countdown.textContent = String(seconds);
    if (seconds <= 0) {
      clearInterval(timer);
      window.location.href = '/';
    }
  }, 1000);
</script>

<style>
.error-page{min-height:calc(100vh - 190px);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:60px 20px}.error-code{font-size:clamp(5rem,15vw,10rem);font-weight:900;line-height:.9;color:#10243d;letter-spacing:-.06em}.error-page h1{font-size:2rem;color:#10243d;margin:20px 0 8px}.error-page>p{color:#64748b;max-width:520px;font-size:1.05rem;line-height:1.6}.actions{display:flex;gap:12px;margin:24px 0 8px;flex-wrap:wrap;justify-content:center}.actions a{padding:11px 20px;border-radius:9px;text-decoration:none;font-weight:700}.home-btn{background:#10243d;color:#fff}.back-btn{border:1px solid #cbd5e1;color:#10243d;background:#fff}.redirect{font-size:.92rem!important}.redirect strong{color:#d97706}
</style>
