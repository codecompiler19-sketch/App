---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';

export function getStaticPaths() {
  return ['html', 'css', 'javascript', 'python', 'sql', 'php', 'computer-science'].map((language) => ({ params: { language } }));
}
const language = Astro.params.language || 'javascript';
const data = {
  html: { name: 'HTML', description: 'HTML interview questions covering document structure, semantic elements, forms, accessibility, media and modern HTML.', topics: ['HTML document structure','DOCTYPE declaration','HTML elements and tags','Block-level and inline elements','Semantic HTML','Headings and paragraphs','Links and navigation','Absolute and relative URLs','Images and alt text','Picture and source elements','Ordered and unordered lists','Tables and captions','Forms and labels','Input types','Form validation','GET versus POST','HTML attributes','Global attributes','data-* attributes','ARIA attributes','Accessibility basics','Audio and video elements','Iframes and sandboxing','Canvas and SVG','Meta viewport','HTML entities','Web storage basics','Script loading','defer versus async','Custom data attributes'] },
  css: { name: 'CSS', description: 'CSS interview questions covering selectors, specificity, box model, layouts, responsive design, animations and maintainable styles.', topics: ['CSS syntax and rules','Ways to add CSS','Selectors','Specificity','Cascade and inheritance','Box model','box-sizing property','Margin collapsing','Display values','Position values','z-index and stacking contexts','Flexbox','CSS Grid','Grid versus Flexbox','Responsive design','Media queries','Container queries','Relative CSS units','Absolute CSS units','CSS variables','Pseudo-classes','Pseudo-elements','Attribute selectors','Combinators','Overflow','Visibility versus display','Transitions','Keyframe animations','Transforms','BEM naming','CSS reset and normalize','Accessible focus styles'] },
  javascript: { name: 'JavaScript', description: 'JavaScript interview questions covering language fundamentals, functions, objects, DOM, asynchronous code and modern features.', topics: ['var, let and const','Primitive and reference types','Type coercion','Strict equality','Scope','Hoisting','Temporal dead zone','Closures','Lexical environment','this keyword','Arrow functions','Function declarations and expressions','Callbacks','Higher-order functions','Promises','async and await','Event loop','Microtasks and macrotasks','Promise.all and Promise.race','Error handling','Arrays and array methods','map, filter and reduce','Objects and prototypes','Prototype chain','Classes and inheritance','Destructuring','Spread and rest syntax','Modules','ESM versus CommonJS','DOM selection','Event bubbling','Event delegation','Event.preventDefault','Local storage and session storage','JSON parsing','Fetch API','CORS basics','Debouncing and throttling','Memory leaks','Shallow versus deep copy'] },
  python: { name: 'Python', description: 'Python interview questions covering syntax, built-in data structures, functions, exceptions, modules, generators and OOP.', topics: ['Python features','Indentation rules','Mutable and immutable types','Lists and tuples','Sets and dictionaries','List comprehensions','Dictionary comprehensions','Generators','yield keyword','Iterators and iterables','Decorators','Lambda functions','*args and **kwargs','Default arguments','LEGB scope rule','Global and nonlocal','Shallow versus deep copy','is versus ==','Identity and equality','Exception handling','Custom exceptions','Context managers','with statement','File handling','Modules and packages','Virtual environments','pip and dependencies','Classes and objects','Inheritance','Multiple inheritance','MRO','Class and static methods','Properties','Dunder methods','Dataclasses','Type hints','GIL basics','Threading versus multiprocessing','Asyncio basics','Unit testing with pytest'] },
  sql: { name: 'SQL', description: 'SQL interview questions covering queries, filtering, joins, grouping, subqueries, transactions, indexes and database design.', topics: ['SQL and relational databases','DDL, DML, DCL and TCL','SELECT statement','WHERE clause','ORDER BY','DISTINCT','NULL values','IS NULL versus equality','LIKE and wildcards','IN and BETWEEN','Aggregate functions','GROUP BY','HAVING versus WHERE','INNER JOIN','LEFT JOIN','RIGHT JOIN','FULL OUTER JOIN','CROSS JOIN','Self join','UNION versus UNION ALL','Subqueries','Correlated subqueries','Common table expressions','Recursive CTEs','Window functions','ROW_NUMBER and RANK','PARTITION BY','CASE expression','Primary keys','Foreign keys','Unique constraints','Indexes','Clustered versus nonclustered indexes','Normalization','First, second and third normal forms','Denormalization','Transactions','ACID properties','COMMIT and ROLLBACK','Isolation levels'] },
  php: { name: 'PHP', description: 'PHP interview questions covering syntax, types, arrays, functions, forms, sessions, security and object-oriented PHP.', topics: ['PHP features','PHP request lifecycle','Variables and constants','PHP data types','Loose versus strict comparison','Type declarations','Null coalescing operator','String interpolation','Common string functions','Indexed and associative arrays','Array functions','Foreach loop','Functions and return values','Pass by value and reference','Anonymous functions','Arrow functions','Closures','Namespaces','Include versus require','Composer and autoloading','Superglobals','GET versus POST','Form validation','Sessions and cookies','Password hashing','SQL injection prevention','Prepared statements','XSS prevention','CSRF protection','File uploads','Error and exception handling','Traits','Interfaces and abstract classes','Inheritance','Static members','Magic methods','Dependency injection','PDO','REST API basics','PHP configuration'] },
  'computer-science': { name: 'Computer Science', description: 'computer science interview questions covering algorithms, data structures, operating systems, networking and databases.', topics: ['Time complexity','Space complexity','Big O notation','Arrays','Linked lists','Stacks','Queues','Hash tables','Binary trees','Binary search trees','Heaps','Graphs','Breadth-first search','Depth-first search','Binary search','Sorting algorithms','Merge sort','Quick sort','Recursion','Dynamic programming','Greedy algorithms','Memoization','Process versus thread','Process states','Context switching','CPU scheduling','Deadlocks','Virtual memory','Paging and segmentation','Cache memory','Operating system kernel','TCP versus UDP','OSI model','TCP/IP model','DNS resolution','HTTP versus HTTPS','IP addresses and subnetting','Public-key cryptography','Relational databases','Database normalization'] }
};
const current = data[language] || data.javascript;
const languages = [['HTML','html'],['CSS','css'],['JavaScript','javascript'],['Python','python'],['SQL','sql'],['PHP','php'],['Computer Science','computer-science']];
const tutorials = [['HTML Tutorials','/tutorial/html-introduction/'],['CSS Tutorials','/tutorial/css-introduction/'],['JavaScript Tutorials','/tutorial/javascript-introduction/'],['Python Tutorials','/tutorial/python-introduction/'],['SQL Tutorials','/tutorial/sql-introduction/'],['PHP Tutorials','/tutorial/php-introduction/']];
const questions = Array.from({ length: 100 }, (_, index) => {
  const topic = current.topics[index % current.topics.length];
  const variation = Math.floor(index / current.topics.length);
  const forms = [
    `What is ${topic}?`,
    `How does ${topic} work?`,
    `When would you use ${topic}?`,
    `What are the advantages and limitations of ${topic}?`
  ];
  return { question: forms[variation % forms.length], level: index < 25 ? 'Beginner' : index < 50 ? 'Intermediate' : index < 75 ? 'Practical' : 'Advanced' };
});
---
<BaseLayout title={`${current.name} Interview Questions`} description={current.description}>
  <section class="hero"><div class="hero-inner"><a class="back" href="/interview-questions/">← All Interview Questions</a><span>INTERVIEW PREPARATION</span><h1>{current.name} Interview Questions</h1><p>{current.description}</p></div></section>
  <main class="layout">
    <aside class="sidebar"><div class="side-card"><h2>Programming Languages</h2><nav aria-label="Programming languages">{languages.map(([name, slug]) => <a class={slug === language ? 'active' : ''} href={`/interview-questions/${slug}/`}>{name}</a>)}</nav></div><div class="side-card"><h2>Tutorials</h2><nav aria-label="Tutorials">{tutorials.map(([name, href]) => <a href={href}>{name}</a>)}</nav></div></aside>
    <section class="content"><div class="heading-row"><div><span class="eyebrow">{current.name.toUpperCase()} QUESTION BANK</span><h2>Explore Interview Questions</h2></div></div><p class="lead">Review these questions as part of your interview preparation. Topics range from foundational concepts to advanced ideas, and this collection can grow over time.</p>
      <ul class="question-list">{questions.map(item => <li class="question"><div><span class="level">{item.level}</span><h3>{item.question}</h3></div></li>)}</ul>
      <p class="back-link"><a href="/interview-questions/">← Browse all interview topics</a></p>
    </section>
    <aside class="ads" aria-label="Advertisements"><AdSlot format="vertical" /><AdSlot format="rectangle" /></aside>
  </main>
</BaseLayout>
<style>
.hero{background:linear-gradient(135deg,#10243d,#173d67);color:#fff;padding:38px 20px 44px}.hero-inner{max-width:1360px;margin:auto}.hero span,.eyebrow{display:block;color:#f5b900;font-size:.75rem;font-weight:800;letter-spacing:.12em}.back{display:inline-block;color:#dbe7f5;text-decoration:none;font-size:.88rem;margin-bottom:22px}.back:hover{color:#f5b900}.hero h1{font-size:clamp(2rem,4vw,2.7rem);margin:9px 0}.hero p{color:#dbe7f5;max-width:800px;line-height:1.6;margin:0}.layout{max-width:1360px;margin:auto;padding:30px 20px 70px;display:grid;grid-template-columns:220px minmax(0,1fr) 180px;gap:24px;align-items:start}.sidebar,.ads{position:sticky;top:18px}.side-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:16px;margin-bottom:18px;box-shadow:0 3px 12px rgba(15,23,42,.05)}.side-card h2{font-size:.9rem;color:#10243d;margin:0 0 10px;padding-bottom:10px;border-bottom:1px solid #e2e8f0}.side-card nav{display:flex;flex-direction:column;gap:3px}.side-card a{color:#475569;text-decoration:none;padding:8px 9px;border-radius:7px;font-size:.9rem}.side-card a:hover,.side-card a.active{background:#fff7d6;color:#8a5a00;font-weight:700}.content{min-width:0}.heading-row{display:flex;justify-content:space-between;align-items:flex-end;gap:14px}.heading-row h2{font-size:1.7rem;color:#10243d;margin:7px 0 0}.count{font-size:.75rem;font-weight:800;color:#8a5a00;background:#fef3c7;padding:7px 10px;border-radius:999px;white-space:nowrap}.lead{color:#64748b;line-height:1.6;margin:10px 0 22px}.question-list{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:10px}.question{display:flex;gap:12px;align-items:flex-start;padding:14px;border:1px solid #e2e8f0;border-radius:10px;background:#fff}.question>div{min-width:0}.level{font-size:.64rem;text-transform:uppercase;letter-spacing:.08em;color:#8a5a00;font-weight:800}.question h3{font-size:.91rem;color:#10243d;line-height:1.45;margin:4px 0 0}.ads{display:flex;flex-direction:column;gap:20px;align-items:center}.back-link{margin-top:24px}.back-link a{color:#8a5a00;font-weight:700;text-decoration:none}.back-link a:hover{text-decoration:underline}@media(max-width:1050px){.layout{grid-template-columns:200px minmax(0,1fr)}.ads{display:none}.question-list{grid-template-columns:1fr}}@media(max-width:700px){.layout{grid-template-columns:1fr;padding:22px 14px 50px}.sidebar{position:static;display:grid;grid-template-columns:1fr 1fr;gap:12px}.side-card{margin:0}.hero{padding:30px 16px}.heading-row{align-items:flex-start;flex-direction:column;gap:8px}}@media(max-width:480px){.sidebar{grid-template-columns:1fr}.side-card nav{display:grid;grid-template-columns:1fr 1fr}}
</style>
