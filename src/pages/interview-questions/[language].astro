---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';

export function getStaticPaths() {
  return ['html', 'css', 'javascript', 'python', 'sql', 'php', 'computer-science'].map((language) => ({ params: { language } }));
}
const language = Astro.params.language || 'html';
const data = {
  html: {
    name: 'HTML',
    description: 'Prepare for HTML interviews with practical questions about semantic structure, accessible forms, responsive images, browser behavior and modern HTML features.',
    questions: [
      { level: 'Beginner', question: 'Why can two HTML pages with the same visible text behave differently in a browser?', answer: 'HTML describes both the content and its meaning. Two pages may look similar but differ in semantics, form behavior, accessibility, document metadata or how browsers interpret invalid markup. Prefer meaningful elements and valid structure rather than choosing tags only for their default appearance.', example: '<main>\n  <h1>Course overview</h1>\n  <p>Learn the essentials of the web.</p>\n</main>' },
      { level: 'Beginner', question: 'When should you choose <section> instead of <div>?', answer: 'Use <section> when the content forms a distinct thematic part of the page, usually with its own heading. Use <div> when you only need a generic container for styling or layout and the group has no particular semantic meaning.', example: '<section aria-labelledby="features-title">\n  <h2 id="features-title">Features</h2>\n  <p>Explore the main features.</p>\n</section>' },
      { level: 'Beginner', question: 'What problem does the alt attribute solve, and what should its value contain?', answer: 'The alt attribute provides a text alternative when an image cannot be seen, including for many screen-reader users. Describe the image’s relevant purpose, not every visual detail. For a purely decorative image, use alt="" so assistive technology can skip it.', example: '<img src="/team.jpg" alt="The product team working together">\n<img src="/divider.svg" alt="">' },
      { level: 'Beginner', question: 'Why should a form label be connected to its input?', answer: 'A programmatically associated label tells assistive technology what a field is for and lets users click the label to focus the input. Match the label’s for value to the input id; placeholder text alone is not a reliable replacement for a label.', example: '<label for="work-email">Work email</label>\n<input id="work-email" name="email" type="email" autocomplete="email" required>' },
      { level: 'Intermediate', question: 'How do required and type="email" validation differ from JavaScript validation?', answer: 'The required attribute and suitable input types provide built-in browser constraint validation before submission. JavaScript can add application-specific rules and clearer feedback, but client-side checks can be bypassed. A server must validate submitted data again.', example: '<form>\n  <label for="email">Email address</label>\n  <input id="email" name="email" type="email" required>\n  <button type="submit">Continue</button>\n</form>' },
      { level: 'Intermediate', question: 'What is the practical difference between defer and async on an external script?', answer: 'Both let the browser download a script while parsing HTML. A deferred classic script executes after parsing and preserves document order. An async script runs as soon as it is ready, so its execution order is not guaranteed. Use defer when scripts depend on the parsed document or on one another.', example: '<script src="/js/site.js" defer></script>\n<script src="/js/analytics.js" async></script>' },
      { level: 'Intermediate', question: 'How can HTML offer different image files for different screen sizes?', answer: 'Use srcset and sizes with img when the browser should choose an appropriate resolution, or use picture and source when you need art direction or different formats. Always provide a useful fallback src and appropriate alt text.', example: '<img src="/photo-800.jpg"\n  srcset="/photo-400.jpg 400w, /photo-800.jpg 800w"\n  sizes="(max-width: 600px) 100vw, 800px"\n  alt="A close-up of a circuit board">'},
      { level: 'Intermediate', question: 'When is an iframe sandbox useful?', answer: 'The sandbox attribute applies restrictions to embedded content, such as limiting scripts, form submission and navigation depending on which permissions you explicitly allow. Start with the fewest permissions needed; add tokens only after understanding the security trade-off.', example: '<iframe src="https://example.org/embed"\n  title="Embedded demo"\n  sandbox\n  loading="lazy"></iframe>' },
      { level: 'Intermediate', question: 'How do the button type values prevent accidental form submissions?', answer: 'Inside a form, a button without an explicit type can act as a submit button. Use type="submit" for submitting, type="button" for JavaScript actions that should not submit, and type="reset" only when resetting the form is genuinely useful.', example: '<button type="button" id="show-help">Show help</button>\n<button type="submit">Save changes</button>' },
      { level: 'Advanced', question: 'What does the viewport meta tag change on mobile devices?', answer: 'It tells mobile browsers how to size the layout viewport. Without it, a phone may lay out the page on a much wider virtual viewport and scale the result down, making text and responsive breakpoints behave unexpectedly.', example: '<meta name="viewport" content="width=device-width, initial-scale=1">' },
      { level: 'Advanced', question: 'Why is native HTML dialog often preferable to building a modal from scratch?', answer: 'The dialog element provides built-in modal behavior through showModal(), including a top-layer presentation and browser-managed focus behavior. You still need a clear title, a way to close it, sensible focus handling and testing with assistive technologies.', example: '<dialog id="help-dialog" aria-labelledby="help-title">\n  <h2 id="help-title">Help</h2>\n  <p>Find answers in the guide.</p>\n  <button type="button" onclick="this.closest(\'dialog\').close()">Close</button>\n</dialog>\n<button onclick="document.querySelector(\'#help-dialog\').showModal()">Open help</button>' },
      { level: 'Advanced', question: 'When should you use ARIA, and when is native HTML enough?', answer: 'Prefer native elements such as button, nav, main and label because their semantics and keyboard behavior are built in. ARIA is useful when native HTML cannot express a widget’s role or state, but incorrect ARIA can make accessibility worse. ARIA changes semantics; it does not automatically implement keyboard interaction.', example: '<button type="button" aria-expanded="false" aria-controls="details">\n  More details\n</button>\n<div id="details" hidden>Additional information.</div>' }
    ]
  },
  css: {
    name: 'CSS',
    description: 'Practice CSS interview questions with clear explanations and examples covering the cascade, layout, responsive design, stacking contexts and maintainable styling.',
    questions: [
      { level: 'Beginner', question: 'Why can a CSS rule appear correct but have no visible effect?', answer: 'The selector may not match, another declaration may win the cascade, the property may not apply to that element, or a parent layout rule may constrain the result. Inspect the element’s computed styles and matched rules in browser developer tools before adding more overrides.', example: '.notice { color: #17324d; }\n/* Check that the element actually has class="notice". */' },
      { level: 'Beginner', question: 'How does box-sizing: border-box make layouts easier to maintain?', answer: 'With content-box, the declared width applies to the content and padding and borders are added outside it. With border-box, the declared width includes content, padding and border, making columns and cards easier to size predictably.', example: '*, *::before, *::after {\n  box-sizing: border-box;\n}\n.card { width: 320px; padding: 24px; border: 1px solid; }' },
      { level: 'Beginner', question: 'How would you explain the difference between margin and padding using a card?', answer: 'Padding creates space inside the border between the content and the edge. Margin creates space outside the border, separating the card from neighboring elements. Backgrounds normally extend through padding, but not through the margin.', example: '.card { padding: 1.25rem; margin-block: 1rem; border: 1px solid #cbd5e1; }' },
      { level: 'Beginner', question: 'Why is a class selector usually more reusable than an ID selector for styling?', answer: 'A class can be shared by many elements and has lower specificity than an ID, which makes component styles easier to reuse and override. IDs are best kept unique in a document and are often useful for fragment links or JavaScript hooks.', example: '.alert { border-left: 4px solid #b45309; }\n/* Reuse class="alert" on multiple messages. */' },
      { level: 'Intermediate', question: 'How do you decide between Flexbox and CSS Grid for a layout?', answer: 'Flexbox is ideal when arranging items along one main axis, such as a toolbar or navigation row. Grid is suited to two-dimensional layouts where rows and columns need coordinated sizing. They can be combined: Grid for the page structure and Flexbox inside individual components.', example: '.dashboard { display: grid; grid-template-columns: 16rem minmax(0, 1fr); gap: 1.5rem; }\n.toolbar { display: flex; align-items: center; gap: .75rem; }' },
      { level: 'Intermediate', question: 'What is CSS specificity, and why is adding !important not the best first fix?', answer: 'Specificity helps the cascade decide between declarations that compete at the same cascade origin and importance. The cascade also considers layers, importance and source order. Repeatedly adding !important creates brittle overrides; simplify selectors and clarify component ownership instead.', example: 'button { color: #334155; }\n.primary-button { color: #075985; }\n/* The class rule wins on an element with both selectors. */' },
      { level: 'Intermediate', question: 'Why does z-index sometimes fail to put a menu above another element?', answer: 'z-index is evaluated within stacking contexts. Properties such as positioned elements with a z-index, transform, opacity below 1 and some containment settings can create new contexts. A child cannot escape its parent stacking context simply by using a very large z-index.', example: '.app-shell { position: relative; z-index: 1; }\n.menu { position: absolute; z-index: 10; }' },
      { level: 'Intermediate', question: 'How would you make a two-column layout adapt without hard-coding device widths?', answer: 'Use flexible tracks such as minmax(0, 1fr), and choose a breakpoint based on when the content becomes cramped rather than a particular phone model. A minmax-based grid can also collapse automatically when the available width is too small.', example: '.cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));\n  gap: 1rem;\n}' },
      { level: 'Intermediate', question: 'When are CSS custom properties more useful than repeating literal values?', answer: 'Custom properties let you define reusable design tokens for colors, spacing or themes. Updating a token can consistently change many components, and properties declared on a container can be overridden for a local theme.', example: ':root { --brand: #155e75; --space-card: 1.25rem; }\n.card { padding: var(--space-card); border-color: var(--brand); }' },
      { level: 'Advanced', question: 'What is the difference between a media query and a container query?', answer: 'A media query responds to viewport or device conditions, such as the available screen width. A container query lets a component respond to the size of its containing element, which is useful when the same component appears in differently sized regions of one page.', example: '.panel-wrap { container-type: inline-size; }\n@container (max-width: 34rem) {\n  .panel { grid-template-columns: 1fr; }\n}' },
      { level: 'Advanced', question: 'How can you respect a user’s reduced-motion preference?', answer: 'Use the prefers-reduced-motion media feature to reduce or remove nonessential movement for people who have enabled that operating-system preference. Avoid relying on animation to communicate essential information.', example: '.tile { transition: transform 180ms ease; }\n@media (prefers-reduced-motion: reduce) {\n  .tile { transition: none; }\n}' },
      { level: 'Advanced', question: 'What causes margin collapsing, and how can layout tools help avoid surprises?', answer: 'In normal block flow, vertical margins of certain adjacent blocks or parent-child combinations can collapse into one margin rather than add together. Flexbox and Grid containers do not collapse their items’ margins in the same way; using gap is often clearer for consistent spacing.', example: '.stack { display: flex; flex-direction: column; gap: 1rem; }\n.stack > * { margin-block: 0; }' }
    ]
  }
};
const current = data[language] || {
  name: language === 'computer-science' ? 'Computer Science' : language.charAt(0).toUpperCase() + language.slice(1),
  description: 'Explore interview preparation topics and build confidence with core concepts, practical examples and technical explanations.',
  questions: []
};
const topics = {
  javascript: ['Closures and lexical scope','Promises and async/await','Event delegation','Array transformation methods','Prototype chain'],
  python: ['Mutable versus immutable values','Generators and iterators','Decorators','Context managers','Exception handling'],
  sql: ['Join strategies','Window functions','Transactions and ACID','Indexes and query plans','NULL handling'],
  php: ['Sessions and cookies','Prepared statements','Interfaces and traits','Composer autoloading','Password hashing'],
  'computer-science': ['Process versus thread','Deadlock conditions','Big O analysis','TCP versus UDP','Database normalization']
};
if (!current.questions.length) {
  current.questions = (topics[language] || topics.javascript).map((topic, index) => ({
    level: index < 2 ? 'Intermediate' : 'Practical',
    question: `How would you explain ${topic} in a technical interview?`,
    answer: `Start by defining ${topic} in your own words, explain the problem it solves, and give a small real-world example. Then mention one trade-off or common mistake. This structure demonstrates understanding rather than memorizing a definition.`,
    example: `// Interview tip: define ${topic}, explain when it is useful,\n// then discuss a practical example and its trade-offs.`
  }));
}
const languages = [['HTML','html'],['CSS','css'],['JavaScript','javascript'],['Python','python'],['SQL','sql'],['PHP','php'],['Computer Science','computer-science']];
const tutorials = [['HTML Tutorials','/tutorial/html-introduction/'],['CSS Tutorials','/tutorial/css-introduction/'],['JavaScript Tutorials','/tutorial/javascript-introduction/'],['Python Tutorials','/tutorial/python-introduction/'],['SQL Tutorials','/tutorial/sql-introduction/'],['PHP Tutorials','/tutorial/php-introduction/']];
---
<BaseLayout title={`${current.name} Interview Questions and Answers`} description={current.description}>
  <section class="hero"><div class="hero-inner"><a class="back" href="/interview-questions/">← All Interview Questions</a><span>INTERVIEW PREPARATION</span><h1>{current.name} Interview Questions and Answers</h1><p>{current.description}</p></div></section>
  <main class="layout">
    <aside class="sidebar"><div class="side-card"><h2>Programming Languages</h2><nav aria-label="Programming languages">{languages.map(([name, slug]) => <a class={slug === language ? 'active' : ''} href={`/interview-questions/${slug}/`}>{name}</a>)}</nav></div><div class="side-card"><h2>Tutorials</h2><nav aria-label="Tutorials">{tutorials.map(([name, href]) => <a href={href}>{name}</a>)}</nav></div></aside>
    <section class="content"><div class="heading-row"><div><span class="eyebrow">{current.name.toUpperCase()} QUESTION BANK</span><h2>Questions with clear answers</h2></div><span class="count">{current.questions.length} questions</span></div><p class="lead">Read each explanation, review the code example, and practise explaining the idea aloud. All answers below are written for CodesCompiler.</p>
      <div class="question-list">{current.questions.map((item, index) => <article class="question" id={`question-${index + 1}`}><div class="question-heading"><span class="level">{item.level}</span><h3>{item.question}</h3></div><div class="answer"><h4>Answer</h4><p>{item.answer}</p><h4>Example</h4><pre><code>{item.example}</code></pre></div></article>)}</div>
      <p class="back-link"><a href="/interview-questions/">← Browse all interview topics</a></p>
    </section>
    <aside class="ads" aria-label="Advertisements"><AdSlot format="vertical" /><AdSlot format="rectangle" /></aside>
  </main>
</BaseLayout>
<style>
.hero{background:linear-gradient(135deg,#10243d,#173d67);color:#fff;padding:38px 20px 44px}.hero-inner{max-width:1360px;margin:auto}.hero span,.eyebrow{display:block;color:#f5b900;font-size:.75rem;font-weight:800;letter-spacing:.12em}.back{display:inline-block;color:#dbe7f5;text-decoration:none;font-size:.88rem;margin-bottom:22px}.back:hover{color:#f5b900}.hero h1{font-size:clamp(2rem,4vw,2.7rem);margin:9px 0}.hero p{color:#dbe7f5;max-width:800px;line-height:1.6;margin:0}.layout{max-width:1360px;margin:auto;padding:30px 20px 70px;display:grid;grid-template-columns:220px minmax(0,1fr) 180px;gap:24px;align-items:start}.sidebar,.ads{position:sticky;top:18px}.side-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:16px;margin-bottom:18px;box-shadow:0 3px 12px rgba(15,23,42,.05)}.side-card h2{font-size:.9rem;color:#10243d;margin:0 0 10px;padding-bottom:10px;border-bottom:1px solid #e2e8f0}.side-card nav{display:flex;flex-direction:column;gap:3px}.side-card a{color:#475569;text-decoration:none;padding:8px 9px;border-radius:7px;font-size:.9rem}.side-card a:hover,.side-card a.active{background:#fff7d6;color:#8a5a00;font-weight:700}.content{min-width:0}.heading-row{display:flex;justify-content:space-between;align-items:flex-end;gap:14px}.heading-row h2{font-size:1.7rem;color:#10243d;margin:7px 0 0}.count{font-size:.75rem;font-weight:800;color:#8a5a00;background:#fef3c7;padding:7px 10px;border-radius:999px;white-space:nowrap}.lead{color:#64748b;line-height:1.6;margin:10px 0 22px}.question-list{display:grid;gap:16px}.question{border:1px solid #dbe3ed;border-radius:12px;background:#fff;overflow:hidden;box-shadow:0 2px 8px rgba(15,23,42,.035)}.question-heading{padding:18px 20px;background:#f8fafc;border-bottom:1px solid #e2e8f0}.level{font-size:.65rem;text-transform:uppercase;letter-spacing:.09em;color:#8a5a00;font-weight:800}.question h3{font-size:1.05rem;color:#10243d;line-height:1.5;margin:7px 0 0}.answer{padding:18px 20px 20px}.answer h4{font-size:.88rem;color:#0f766e;margin:0 0 7px}.answer p{color:#475569;line-height:1.75;margin:0 0 18px}.answer pre{margin:0;overflow-x:auto;padding:15px;border-radius:8px;background:#10243d;color:#e2e8f0;font-size:.86rem;line-height:1.65;white-space:pre}.back-link{margin-top:24px}.back-link a{color:#8a5a00;font-weight:700;text-decoration:none}.back-link a:hover{text-decoration:underline}.ads{display:flex;flex-direction:column;gap:20px;align-items:center}@media(max-width:1050px){.layout{grid-template-columns:200px minmax(0,1fr)}.ads{display:none}}@media(max-width:700px){.layout{grid-template-columns:1fr;padding:22px 14px 50px}.sidebar{position:static;display:grid;grid-template-columns:1fr 1fr;gap:12px}.side-card{margin:0}.hero{padding:30px 16px}.heading-row{align-items:flex-start;flex-direction:column;gap:8px}.question-heading,.answer{padding:15px}}@media(max-width:480px){.sidebar{grid-template-columns:1fr}.side-card nav{display:grid;grid-template-columns:1fr 1fr}}
</style>
